@model IDAProject.Web.Admin.Models.ViewModels.Projects.ProjectsViewModel
@using IDAProject.Web.Admin.Models.Common;
@using IDAProject.Web.Models.General.Enums
@using IDAProject.Web.Models.RequestModels.MasterData;
@using IDAProject.Web.Admin.Models.TagHelpers;
@using System.ComponentModel;
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> localizer
@addTagHelper IDAProject.Web.Admin.TagHelpers.*, IDAProject.Web.Admin

@{

    ViewData["Title"] = $"Projects";
    var localizedPagination = @Html.Raw(Json.Serialize(new PaginationLocalizerModel(localizer)));
    var urlDelete = Url.RouteUrl(RouteNames.Projects_Delete, new { id = 111 });
    var urlPatternProjectEmployees = Url.RouteUrl(RouteNames.ProjectEmployees_ListByProjectId, new {ProjectId = "111"});
}
<tms-modal id="editProjectEmployeesModal" title="@localizer["Project employees"]" save-button="false" modal-size="@ModalSize.Default" />
<div class="row">
    <div class="col-lg-12 col-md-12">
        <div class="card">
            <div class="card-header border-bottom">
                <h4 class="mb-0">@localizer["Projects"]</h4>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <partial name="ContextOptionsPartial" model="@Model" />
    </div>
</div>
<div class="row row-sm">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body" style="overflow-x:auto">
                <tms-ajax-table id="tableProjects" view-model="@Model" table-settings-reference-table="Projects" />
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" type="text/css" href="~/lib/select2/select2.min.css" />
}
@section Scripts {

    <script type="text/javascript" src="~/lib/select2/select2.min.js"></script>
    <script type="text/javascript">

        function searchProjects() {

            $.ajax({
                url: "@Url.RouteUrl(RouteNames.Projects_Search)",
                method: "POST",
                data: {
                    keyword : $("#empSearchKeyword").val()
                },
                success: function (response) {
                    loadJson("tableProjects", response, @localizedPagination);
                }
            });
        }

        $(document).ready(function () {
            $("#edit").click(function () {
                var selectedId = getSelectedItemId("tableProjects");
                document.location = '@Url.RouteUrl(RouteNames.Projects_Edit, new { id = "111" })'.replace("111", selectedId);
            });
            $("#delete").click(function () {
                Swal.fire({
                    title: '@localizer["DeleteQuestion"]',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: '@localizer["DeleteConfirmation"]'
                }).then((result) => {
                    if (result.isConfirmed) {
                        var selectedId = getSelectedItemId("tableProjects");
                        $.ajax({
                            url: '@urlDelete'.replace("111", selectedId),
                            method: "POST",
                            success: function (response) {
                                location = response.message;
                            }
                        });
                    }
                })
            });

            $("#buttonSearch").click(function(){
                searchProjects();
            });
            $("#buttonResetSearch").click(function(){
                $("#empSearchKeyword").val(null);
                searchProjects();
            });

            searchProjects();

            $("#addEmployees").click(function () {
                var selectedId = getSelectedItemId("tableProjects");
                $.ajax({
                    url: '@urlPatternProjectEmployees'.replace("111", selectedId),
                    method: 'GET',
                    success: function (response) {
                        $("#editProjectEmployeesModal .modal-body").html(response);

                        var editModal = new bootstrap.Modal(document.getElementById('editProjectEmployeesModal'));
                        editModal.show();
                    }
                });
            });
        });
    </script>
}