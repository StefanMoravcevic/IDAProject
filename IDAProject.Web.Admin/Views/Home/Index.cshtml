    function renderNotificationsFrontend(notifications, jobTypeId) {
        var allUsersContainer = $('#allUsersSection');
        var groupContainer = $('#groupSection');

        // očisti stare poruke
        allUsersContainer.empty();
        groupContainer.empty();

        var hasAllUsers = false;
        var hasGroup = false;

        notifications.forEach(function(n) {
            var iconHtml = '<i class="fa fa-bell" style="margin-right: 5px;"></i>';

            if (n.forAllUsers) {
                hasAllUsers = true;
                allUsersContainer.append(
                    '<div class="notification-alert all-users">' + iconHtml + n.note + '</div>'
                );
            } else if (n.jobTypeId === jobTypeId) {
                hasGroup = true;
                groupContainer.append(
                    '<div class="notification-alert group">' + iconHtml + n.note + '</div>'
                );
            }
        });

        if (!hasAllUsers) allUsersContainer.append('<div>Trenutno nema obaveštenja za sve korisnike.</div>');
        if (!hasGroup) groupContainer.append('<div>Trenutno nema obaveštenja za vašu grupu.</div>');
    }
