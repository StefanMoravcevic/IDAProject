<script src="~/lib/chart/chart.js"></script>

<div class="container-fluid mt-1">
    <div class="row g-3">

        <!-- Leva kolona: Profilna slika u svom cardu -->
        <div class="col-md-2">
            <div class="card p-3 text-center">
                <!-- Slika centrirana -->
                <div class="d-flex justify-content-center mb-3">
                    <img src="@Model.EmployeePhoto"
                         alt="Profilna slika"
                         class="img-fluid rounded-circle"
                         style="width: 150px; height: 150px;" />
                </div>

                <!-- Dugmad ispod slike -->
                <div class="d-flex flex-column gap-2">
                    <a href="@urlLogout" class="btn btn-danger btn-sm">
                        @localizer["Log out"]
                    </a>
                    <a href="/Home/Instructions" class="btn btn-primary btn-sm">
                        @localizer["Manual"]
                    </a>
                </div>
            </div>
        </div>

        <!-- Desna kolona: Tekst i obaveštenja u svom cardu -->
        <div class="col-md-10">
            <div class="card p-3">
                <h2 class="fs-4 mb-3">Zdravo @Model.User.FirstName!</h2>

                <div id="userNotifications">
                    <!-- Sekcija za sve korisnike -->
                    <h6 class="section-title">@localizer["Notifications for all users"]</h6>
                    <div class="notification-section mb-3" id="allUsersSection">
                        <!-- Ovde JS ubacuje obaveštenja -->
                    </div>

                    <!-- Sekcija za grupu -->
                    <h6 class="section-title">@localizer["Notifications for your group"]</h6>
                    <div class="notification-section" id="groupSection">
                        <!-- Ovde JS ubacuje obaveštenja -->
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<div class="container-fluid mt-4">
    <div class="card comments-card">
        <!-- Zaglavlje kartice sa dugmetom za collapse -->
        <div class="card-header d-flex justify-content-between align-items-center"
             style="cursor: pointer; background-color:#F2220F; color:white;"
             data-bs-toggle="collapse"
             data-bs-target="#commentsCollapse"
             aria-expanded="true"
             aria-controls="commentsCollapse">
            <span style="font-weight:900; font-size:17px;">@localizer["Comments"]</span>
            <button class="btn btn-sm" style="background-color:white;">
                <span class="collapse-icon">−</span>
            </button>
        </div>

        <!-- Collapse telo kartice -->
        <div id="commentsCollapse" class="collapse show">
            <div class="card-body p-3">
                <div class="row">
                    <div class="col-md-6 border-end pe-3">
                        <h6>@localizer["Plan comments"]</h6>
                        <div id="planCommentsContainer"></div>
                    </div>
                    <div class="col-md-6 ps-3">
                        <h6>@localizer["Realization comments"]</h6>
                        <div id="realizationCommentsContainer"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid mt-4">
    <div class="row g-3">

        <!-- Leva kolona: Lista označenih zaposlenih -->
        <div class="col-md-2">
            <div class="card p-3 h-100">
                <h5 class="card-title">@localizer["Bookmarked employees"]</h5>
                <div id="trackedEmployeesList">
                    <!-- AJAX puni ovu listu -->
                </div>
            </div>
        </div>
        <div class="col-md-10">
            <div class="card p-3 h-100">
                <h5 class="card-title">@localizer["Planned/Realized for today"]</h5>
                <div id="rightPanel">
                    <!-- Ovde ćemo ubacivati dve kolone: plan i realizacija -->
                    <div class="row g-3">
                        <div class="col-12 col-md-5">
                            <div id="plannedTablesContainer"></div>
                            <div id="plannedChartsContainer" class="d-flex justify-content-center align-items-center" style="max-height:320px;">
                                <canvas id="planPieChart" style="max-width:320px;"></canvas>
                            </div>
                        </div>
                        <div class="col-12 col-md-7">
                            <div id="realizedTablesContainer"></div>
                            <div id="realizedChartsContainer" class="d-flex justify-content-center align-items-center" style="max-height:320px;">
                                <canvas id="realizationPieChart" style="max-width:320px;"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


<script>
    let planPieChart;
    let realizationPieChart;
    function loadTrackedEmployees() {
        var employeeId = @Model.User.EmployeeId;

        $.ajax({
            url: '@Url.RouteUrl(RouteNames.EmployeeViewTrackings_Search)',
            method: 'POST',
            data: { employeeId: employeeId, isBookmarked : true},
            success: function(response) {
                if (response && response.length) {
                    let html = '';
                    response.forEach(e => {
                        html += `
                            <div class="tracked-employee d-flex justify-content-between align-items-center" data-id="${e.viewedEmployeeId}">
                                <span>${e.viewedEmployee}</span>
                                <i class="fa fa-times remove-employee" style="cursor:pointer; color:#ff4d4d;"></i>
                            </div>
                        `;
                    });
                    $('#trackedEmployeesList').html(html);
                } else {
                    $('#trackedEmployeesList').html('<div>Nema označenih zaposlenih.</div>');
                }
            },
            error: function(err) {
                console.error('Greška pri učitavanju označenih:', err);
            }
        });
    }

    function searchUserNotifications() {
        var jobTypeId = @Model.EmployeeJobTypeId;

        $.ajax({
            url: '@Url.RouteUrl(RouteNames.UserNotifications_SearchForHomePage)',
            method: 'POST',
            data: { jobTypeId: jobTypeId },
            success: function(notifications) {
                renderNotificationsFrontend(notifications, jobTypeId);
            },
            error: function(err) {
                console.error("Greška pri učitavanju obaveštenja", err);
                $('#userNotifications').text('Greška pri učitavanju obaveštenja.');
            }
        });
    }
    function renderNotificationsFrontend(notifications, jobTypeId) {
        var allUsersContainer = $('#allUsersSection');
        var groupContainer = $('#groupSection');

        // očisti stare poruke
        allUsersContainer.empty();
        groupContainer.empty();

        var hasAllUsers = false;
        var hasGroup = false;

        notifications.forEach(function(n) {
            var iconHtml = '<i class="fa fa-bell" style="margin-right: 5px;"></i>';

            if (n.forAllUsers) {
                hasAllUsers = true;
                allUsersContainer.append(
                    '<div class="notification-alert all-users">' + iconHtml + n.note + '</div>'
                );
            } else if (n.jobTypeId === jobTypeId) {
                hasGroup = true;
                groupContainer.append(
                    '<div class="notification-alert group">' + iconHtml + n.note + '</div>'
                );
            }
        });

        if (!hasAllUsers) allUsersContainer.append('<div>Trenutno nema obaveštenja za sve korisnike.</div>');
        if (!hasGroup) groupContainer.append('<div>Trenutno nema obaveštenja za vašu grupu.</div>');
    }
    function searchTaskPlanningComments() {
        var employeeId = '@Model.EmployeeId';
        $.ajax({
          url: "@Url.RouteUrl(RouteNames.TasksPlanningComments_Search)",
          method: "POST",
          data: 
          { 
              employeeId: employeeId,
              hideFromHomePage : false
          },
          success: function (response) {
              renderComments(response);
          },
          error: function(err) {
              console.error("Greška pri učitavanju komentara", err);
          }
        });
    }
    function searchTaskRealizationComments() {
        var employeeId = '@Model.EmployeeId';
        $.ajax({
          url: "@Url.RouteUrl(RouteNames.TasksRealizationComments_Search)",
          method: "POST",
          data:
          {
              employeeId: employeeId,
              hideFromHomePage : false
          },
          success: function (response) {
              renderRealizationComments(response);
          },
          error: function(err) {
              console.error("Greška pri učitavanju komentara", err);
          }
        });
    }
    function renderComments(comments) {
        var container = $('#planCommentsContainer');
        container.empty();

        if (!comments || comments.length === 0) {
            container.html('<p class="text-muted">Trenutno nema novih komentara na vaše planove.</p>');
            return;
        }

        comments.forEach(function(c) {
               var html = `
        <div class="comment-item mb-2 p-2" data-comment-id="${c.id}">
            <div class="d-flex align-items-center mb-1 justify-content-between">
                <div class="d-flex align-items-center">
                    <img src="${c.photo}"
                         alt="${c.username}"
                         class="rounded-circle me-2"
                         style="width: 40px; height: 40px; object-fit: cover;">
                    <span><strong>${c.username}</strong> je komentarisao/la vaš plan - ${c.displayTask}, ${c.activity}</span>
                </div>
                <!-- X ikonica umesto dugmeta -->
                <span class="remove-comment-icon" title="Ukloni">&times;</span>
            </div>
            <small class="text-muted mb-1 d-block">${c.createdAtFormatted}</small>
            <div>${c.comment}</div>
        </div>
    `;
            container.append(html);
        });
    }
    function renderRealizationComments(comments) {
        var container = $('#realizationCommentsContainer');
        container.empty();

        if (!comments || comments.length === 0) {
            container.html('<p class="text-muted">Trenutno nema novih komentara na vaše realizacije.</p>');
            return;
        }

        comments.forEach(function(c) {
            var html = `
                <div class="comment-item-real mb-2 p-2" data-comment-id="${c.id}">
                    <div class="d-flex align-items-center mb-1 justify-content-between">
                        <div class="d-flex align-items-center">
                            <img src="${c.photo}"
                                 alt="${c.username}"
                                 class="rounded-circle me-2"
                                 style="width: 40px; height: 40px; object-fit: cover;">
                            <span><strong>${c.username}</strong> je komentarisao/la vašu realizaciju - ${c.displayTask}, ${c.activity}</span>
                        </div>
                       <span class="remove-comment-icon-realization" title="Ukloni">&times;</span>
                    </div>
                    <small class="text-muted mb-1 d-block">${c.createdAtFormatted}</small>
                    <div>${c.comment}</div>
                </div>
            `;
            container.append(html);
        });
    }
        function renderPlanPieChart(stats) {
            if (!stats || Object.keys(stats).length === 0) return;

            const chartContainer = $('#plannedChartsContainer');

            // Ako canvas već postoji, ne kreiramo novi
            let canvas = document.getElementById('planPieChart');
            if (!canvas) {
                chartContainer.empty();
                chartContainer.append('<canvas id="planPieChart" style="width:100%; max-width:320px;"></canvas>');
                canvas = document.getElementById('planPieChart');
            }

            const ctx = canvas.getContext('2d');
            const total = Object.values(stats).reduce((a, b) => a + b, 0);

            if (planPieChart) planPieChart.destroy();

            planPieChart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: Object.keys(stats),
                    datasets: [{
                        data: Object.values(stats),
                        backgroundColor: ['#FF6384','#36A2EB','#FFCE56','#4BC0C0','#9966FF','#FF9F40']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: true, position: 'bottom' },
                        datalabels: {
                            color: '#fff',
                            formatter: value => !total ? '0%' : ((value/total)*100).toFixed(1)+'%',
                            font: { weight: 'bold', size: 14 }
                        }
                    }
                },
                plugins: [ChartDataLabels]
            });
        }
        function renderRealizationPieChart(stats) {
            if (!stats || Object.keys(stats).length === 0) return;

            const chartContainer = $('#realizedChartsContainer');

            // Ako canvas već postoji, ne kreiramo novi
            let canvas = document.getElementById('realizationPieChart');
            if (!canvas) {
                chartContainer.empty();
                chartContainer.append('<canvas id="realizationPieChart" style="width:100%; max-width:320px;"></canvas>');
                canvas = document.getElementById('realizationPieChart');
            }

            const ctx = canvas.getContext('2d');
            const total = Object.values(stats).reduce((a, b) => a + b, 0);

            if (realizationPieChart) realizationPieChart.destroy();

            realizationPieChart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: Object.keys(stats),
                    datasets: [{
                        data: Object.values(stats),
                        backgroundColor: ['#FF6384','#36A2EB','#FFCE56','#4BC0C0','#9966FF','#FF9F40']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: true, position: 'bottom' },
                        datalabels: {
                            color: '#fff',
                            formatter: value => !total ? '0%' : ((value/total)*100).toFixed(1)+'%',
                            font: { weight: 'bold', size: 14 }
                        }
                    }
                },
                plugins: [ChartDataLabels]
            });
        }
        function loadEmployeePlannings(employeeId) {
            $.ajax({
                url: "@Url.RouteUrl(RouteNames.TasksPlannings_Search)",
                method: "POST",
                data: {
                    employeeId: employeeId,
                    planDate: '@Model.Today'
                },
                success: function(data) {
                    const tbodyContainer = $('#plannedTablesContainer');
                    tbodyContainer.empty();

                    let stats = {};

                    if (data && data.length) {
                        let tableHtml = `
                            <table class="table table-modern">
                                <thead>
                                    <tr>
                                        <th class="col-activity">@localizer["Your task"]</th>
                                        <th class="col-activity">@localizer["Activity"]</th>
                                        <th class="col-from">@localizer["Time from"]</th>
                                        <th class="col-to">@localizer["Time to"]</th>
                                        <th class="col-duration">@localizer["Duration"]</th>
                                        <th class="col-order">@localizer["Id"]</th>
                                        <th style="width:30px;">@localizer["Finished"]</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        `;
                        tbodyContainer.append(tableHtml);
                        const tbody = tbodyContainer.find('tbody');

                        data.forEach(item => {
                            let finishedIcon = item.isFinished === null ? '-' :
                                               item.isFinished === true ? '<span style="color:green;font-weight:bold;">✔</span>' :
                                               '<span style="color:red;font-weight:bold;">✖</span>';

                            let row = `
                                <tr data-id="${item.id}">
                                    <td>${item.displayTask ?? ""}</td>
                                    <td>${item.activityName ?? ""}</td>
                                    <td>${item.timeFromFormatted ?? ""}</td>
                                    <td>${item.timeToFormatted ?? ""}</td>
                                    <td>${item.durationFormatted ?? ""}</td>
                                    <td>${item.planNo ?? ""}</td>
                                    <td class="text-center">${finishedIcon}</td>
                                </tr>
                            `;
                            tbody.append(row);

                            let type = item.activityTypeName ?? "Unknown";
                            stats[type] = (stats[type] || 0) + 1;
                        });
                        renderPlanPieChart(stats);

                    } else {
                        tbodyContainer.append('<div class="text-center">Nema podataka za ovog zaposlenog.</div>');
                    }
                },
                error: function(err) {
                    console.error('Greška pri učitavanju realizacija:', err);
                }
            });
        }
        function loadEmployeeRealizations(employeeId) {
            $.ajax({
                url: "@Url.RouteUrl(RouteNames.TasksRealizations_Search)",
                method: "POST",
                data: {
                    employeeId: employeeId,
                    realizationDate: '@Model.Today'
                },
                success: function(data) {
                    const tbodyContainer = $('#realizedTablesContainer');
                    tbodyContainer.empty();

                    let stats = {};

                    if (data && data.length) {
                        let tableHtml = `
                            <table class="table table-modern">
                                <thead>
                                    <tr>
                                        <th class="col-activity">@localizer["Your task"]</th>
                                        <th class="col-activity">@localizer["Activity"]</th>
                                        <th class="col-from">@localizer["Time from"]</th>
                                        <th class="col-to">@localizer["Time to"]</th>
                                        <th class="col-duration">@localizer["Duration"]</th>
                                        <th class="col-duration">@localizer["Report"]</th>
                                        <th class="col-order">@localizer["Id"]</th>
                                        <th style="width:30px;">@localizer["Finished"]</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        `;
                        tbodyContainer.append(tableHtml);
                        const tbody = tbodyContainer.find('tbody');

                        data.forEach(item => {
                            let finishedIcon = item.isFinished === null ? '-' :
                                               item.isFinished === true ? '<span style="color:green;font-weight:bold;">✔</span>' :
                                               '<span style="color:red;font-weight:bold;">✖</span>';

                            let row = `
                                <tr data-id="${item.id}">
                                    <td>${item.displayTask ?? ""}</td>
                                    <td>${item.activity ?? ""}</td>
                                    <td>${item.report ?? ""}</td>
                                    <td>${item.timeFromFormattedForTable ?? ""}</td>
                                    <td>${item.timeToFormattedForTable ?? ""}</td>
                                    <td>${item.durationFormattedForTable ?? ""}</td>
                                    <td>${item.planNo ?? ""}</td>
                                    <td class="text-center">${finishedIcon}</td>
                                </tr>
                            `;
                            tbody.append(row);

                            let type = item.activityType ?? "Unknown";
                            stats[type] = (stats[type] || 0) + 1;
                        });
                        renderRealizationPieChart(stats);

                    } else {
                        tbodyContainer.append('<div class="text-center">Nema podataka za ovog zaposlenog.</div>');
                    }
                },
                error: function(err) {
                    console.error('Greška pri učitavanju realizacija:', err);
                }
            });
        }
    $(document).ready(function () {
        searchTaskPlanningComments();
        searchTaskRealizationComments();
        searchUserNotifications();
        loadTrackedEmployees();
        $(document).on('click', '.remove-comment-icon', function() {
            var commentDiv = $(this).closest('.comment-item'); // <-- promenjeno
            var commentId = commentDiv.data('comment-id');
            debugger
            $.ajax({
                url: "@Url.RouteUrl(RouteNames.TasksPlanningComments_Hide)",
                method: "POST",
                data: { id: commentId },
                success: function() {
                    commentDiv.remove();
                },
                error: function(err) {
                    console.error("Greška pri uklanjanju komentara", err);
                }
            });
        });

    // Realizacija
        $(document).on('click', '.remove-comment-icon-realization', function() {
            var commentDiv = $(this).closest('.comment-item-real'); // <-- promenjeno
            var commentId = commentDiv.data('comment-id');
            debugger
            $.ajax({
                url: "@Url.RouteUrl(RouteNames.TasksRealizationComments_Hide)",
                method: "POST",
                data: { id: commentId },
                success: function() {
                    commentDiv.remove();
                },
                error: function(err) {
                    console.error("Greška pri uklanjanju komentara", err);
                }
            });
        });
        var collapseElement = document.getElementById('commentsCollapse');
        collapseElement.addEventListener('show.bs.collapse', function () {
            document.querySelector('.collapse-icon').textContent = '−';
        });
        collapseElement.addEventListener('hide.bs.collapse', function () {
            document.querySelector('.collapse-icon').textContent = '+';
        });

        $(document).on('click', '.tracked-employee', function() {
            var selectedUserId = $(this).data('id');

            $('.tracked-employee').removeClass('selected-employee');
            $(this).addClass('selected-employee');

            $('#plannedTablesContainer').empty();
            $('#plannedChartsContainer').empty();
            $('#realizedTablesContainer').empty();
            $('#realizedChartsContainer').empty();

            loadEmployeePlannings(selectedUserId);
            loadEmployeeRealizations(selectedUserId);
        });
        
    });
</script>
