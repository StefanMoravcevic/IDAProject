<script>
    let planPieChart;
    let realizationPieChart;
    function loadPlanStatistics() {
        var employeeId = @Model.User.EmployeeId;
        $.ajax({
            url: '@Url.RouteUrl(RouteNames.TasksPlannings_GetStatsByEmployeeId, new { employeeId = @Model.User.EmployeeId })',
            method: 'GET',
            success: function(stats) {
                if (!stats) {
                    $('#planStatisticContainer').html('<div class="text-muted">Nema statistike.</div>');
                    return;
                }

                let percentage = stats.totalPlannedDays > 0
                    ? ((stats.plannedOnTimeDays / stats.totalPlannedDays) * 100).toFixed(2)
                    : 0;

                // Odredi boju procenta
                let percColor = percentage >= 80 ? 'text-success' :
                                percentage >= 50 ? 'text-warning' : 'text-danger';

                let html = `
                    <table class="table table-bordered table-striped mb-2 shadow-sm">
                        <thead class="table-light">
                            <tr class="text-center">
                                <th style="background-color:#e07b00; color:white;">@localizer["Planned on time"]</th>
                                <th style="background-color:#e07b00; color:white;">@localizer["Planned"]</th>
                                <th style="background-color:#e07b00; color:white;">@localizer["Planned % from sum"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="text-center align-middle">
                                <td class="fw-bold">${stats.plannedOnTimeDays}</td>
                                <td class="fw-bold">${stats.totalPlannedDays}</td>
                                <td class="${percColor} fw-bold">${percentage}%</td>
                            </tr>
                        </tbody>
                    </table>
                `;

                $('#planStatisticContainer').html(html);
            },
            error: function(err) {
                console.error('Greška pri učitavanju statistike:', err);
                $('#planStatisticContainer').html('<div class="text-danger">Greška pri učitavanju statistike.</div>');
            }
        });
    }
        function loadRealizationStatistics() {
        var employeeId = @Model.User.EmployeeId;
        $.ajax({
            url: '@Url.RouteUrl(RouteNames.TasksRealizations_StatsByEmployeeId, new { employeeId = @Model.User.EmployeeId })',
            method: 'GET',
            success: function(stats) {
                if (!stats) {
                    $('#realizationStatisticContainer').html('<div class="text-muted">Nema statistike.</div>');
                    return;
                }

                let html = `
                    <table class="table table-bordered table-striped mb-2 shadow-sm">
                        <thead class="table-light text-center">
                            <tr>
                                <th style="background-color:#e07b00; color:white;">@localizer["Total working days"]</th>
                                <th style="background-color:#e07b00; color:white;">@localizer["Days with realization"]</th>
                                <th style="background-color:#e07b00; color:white;">@localizer["Total work hours"]</th>
                                <th style="background-color:#e07b00; color:white;">@localizer["Total logged hours"]</th>
                                <th style="background-color:#e07b00; color:white;">@localizer["Planned"]</th>
                                <th style="background-color:#e07b00; color:white;">@localizer["Unplanned"]</th>
                                <th style="background-color:#e07b00; color:white;">@localizer["Projects"]</th>
                                <th style="background-color:#e07b00; color:white;">@localizer["Tasks"]</th>
                                <th style="background-color:#e07b00; color:white;">@localizer["Regular"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="text-center align-middle">
                                <td class="fw-bold">${stats.totalWorkingDays}</td>
                                <td class="fw-bold">${stats.daysWithRealization}</td>
                                <td class="fw-bold">${stats.totalWorkHours}</td>
                                <td class="fw-bold">${stats.totalLoggedHours}</td>
                                <td class="fw-bold">${stats.plannedCount} (${stats.plannedPercentage}%)</td>
                                <td class="fw-bold">${stats.unplannedCount} (${stats.unplannedPercentage}%)</td>
                                <td class="fw-bold">${stats.projectCount} (${stats.projectPercentage}%)</td>
                                <td class="fw-bold">${stats.taskCount} (${stats.taskPercentage}%)</td>
                                <td class="fw-bold">${stats.regularCount} (${stats.regularPercentage}%)</td>
                            </tr>
                        </tbody>
                    </table>
                `;

                $('#realizationStatisticContainer').html(html);
            },
            error: function(err) {
                console.error('Greška pri učitavanju statistike:', err);
                $('#realizationStatisticContainer').html('<div class="text-danger">Greška pri učitavanju statistike.</div>');
            }
        });
        }

       function searchEmployeeGoals() {

        var employeeId = @Model.User.EmployeeId;

        $.ajax({
            url: '@Url.RouteUrl(RouteNames.EmployeeGoals_Search)',
            method: 'POST',
            data: { employeeId: employeeId, isActive: true },
            success: function (response) {
                if (response && response.length) {
    

                    let year = response[0].year;

                    $("#goalsTitle").html(
                        `<i class="fa fa-bullseye me-2 text-primary"></i>
                         Vaši ciljevi za ${year}. godinu`
                    );

                    let html = '';

                    response.forEach(g => {
                        html += `
                            <div class="card mb-2 shadow-sm">
                                <div class="card-body p-2">
                                    ${g.goal}
                                </div>
                            </div>
                        `;
                    });

                    $('#employeeGoalsList').html(html);

                } else {

                    $("#goalsTitle").html(
                        `<i class="fa fa-bullseye me-2 text-primary"></i>
                         Vaši ciljevi`
                    );

                    $('#employeeGoalsList').html(
                        '<div class="text-muted">Nemate definisane ciljeve za ovu godinu.</div>'
                    );
                }
            },
            error: function (err) {
                console.error('Greška pri učitavanju ciljeva:', err);
            }
        });
    }
    function loadTrackedEmployees() {
        var employeeId = @Model.User.EmployeeId;

        $.ajax({
            url: '@Url.RouteUrl(RouteNames.EmployeeViewTrackings_Search)',
            method: 'POST',
            data: { employeeId: employeeId, isBookmarked : true, hideFromHomePage : false},
            success: function(response) {
                if (response && response.length) {
                    let html = '';
                    response.forEach(e => {
                        html += `
                            <div class="tracked-employee d-flex justify-content-between align-items-center"
                                 data-id="${e.viewedEmployeeId}"
                                 data-trackingid="${e.id}">      
                                <span>${e.viewedEmployee}</span>
                                <i class="fa fa-times remove-employee" style="cursor:pointer; color:#ff4d4d;"></i>
                            </div>
                        `;
                    });
                    $('#trackedEmployeesList').html(html);
                } else {
                    $('#trackedEmployeesList').html('<div>Nema označenih zaposlenih.</div>');
                }
            },
            error: function(err) {
                console.error('Greška pri učitavanju označenih:', err);
            }
        });
    }

    function searchUserNotifications() {
        var jobTypeId = @Model.EmployeeJobTypeId;

        $.ajax({
            url: '@Url.RouteUrl(RouteNames.UserNotifications_SearchForHomePage)',
            method: 'POST',
            data: { jobTypeId: jobTypeId },
            success: function(notifications) {
                renderNotificationsFrontend(notifications, jobTypeId);
            },
            error: function(err) {
                console.error("Greška pri učitavanju obaveštenja", err);
                $('#userNotifications').text('Greška pri učitavanju obaveštenja.');
            }
        });
    }
    function renderNotificationsFrontend(notifications, jobTypeId) {
        var allUsersContainer = $('#allUsersSection');
        var groupContainer = $('#groupSection');

        // očisti stare poruke
        allUsersContainer.empty();
        groupContainer.empty();

        var hasAllUsers = false;
        var hasGroup = false;

        notifications.forEach(function(n) {
            var iconHtml = '<i class="fa fa-bell" style="margin-right: 5px;"></i>';

            if (n.forAllUsers) {
                hasAllUsers = true;
                allUsersContainer.append(
                    '<div class="notification-alert all-users">' + iconHtml + n.note + '</div>'
                );
            } else if (n.jobTypeId === jobTypeId) {
                hasGroup = true;
                groupContainer.append(
                    '<div class="notification-alert group">' + iconHtml + n.note + '</div>'
                );
            }
        });

        if (!hasAllUsers) allUsersContainer.append('<div>Trenutno nema obaveštenja za sve korisnike.</div>');
        if (!hasGroup) groupContainer.append('<div>Trenutno nema obaveštenja za vašu grupu.</div>');
    }
    function searchTaskPlanningComments() {
        var employeeId = '@Model.EmployeeId';
        $.ajax({
          url: "@Url.RouteUrl(RouteNames.TasksPlanningComments_Search)",
          method: "POST",
          data: 
          { 
              employeeId: employeeId,
              hideFromHomePage : false
          },
          success: function (response) {
              renderComments(response);
          },
          error: function(err) {
              console.error("Greška pri učitavanju komentara", err);
          }
        });
    }
    function searchTaskRealizationComments() {
        var employeeId = '@Model.EmployeeId';
        $.ajax({
          url: "@Url.RouteUrl(RouteNames.TasksRealizationComments_Search)",
          method: "POST",
          data:
          {
              employeeId: employeeId,
              hideFromHomePage : false
          },
          success: function (response) {
              renderRealizationComments(response);
          },
          error: function(err) {
              console.error("Greška pri učitavanju komentara", err);
          }
        });
    }
    function renderComments(comments) {
        var container = $('#planCommentsContainer');
        container.empty();

        if (!comments || comments.length === 0) {
            container.html('<p class="text-muted">Trenutno nema novih komentara na vaše planove.</p>');
            return;
        }

        comments.forEach(function(c) {
               var html = `
        <div class="comment-item mb-2 p-2" data-comment-id="${c.id}">
            <div class="d-flex align-items-center mb-1 justify-content-between">
                <div class="d-flex align-items-center">
                    <img src="${c.photo}"
                         alt="${c.username}"
                         class="rounded-circle me-2"
                         style="width: 40px; height: 40px; object-fit: cover;">
                    <span><strong>${c.username}</strong> je komentarisao/la vaš plan - ${c.displayTask}, ${c.activity}</span>
                </div>
                <!-- X ikonica umesto dugmeta -->
                <span class="remove-comment-icon" title="Ukloni">&times;</span>
            </div>
            <small class="text-muted mb-1 d-block">${c.createdAtFormatted}</small>
            <div>${c.comment}</div>
        </div>
    `;
            container.append(html);
        });
    }
    function renderRealizationComments(comments) {
        var container = $('#realizationCommentsContainer');
        container.empty();

        if (!comments || comments.length === 0) {
            container.html('<p class="text-muted">Trenutno nema novih komentara na vaše realizacije.</p>');
            return;
        }

        comments.forEach(function(c) {
            var html = `
                <div class="comment-item-real mb-2 p-2" data-comment-id="${c.id}">
                    <div class="d-flex align-items-center mb-1 justify-content-between">
                        <div class="d-flex align-items-center">
                            <img src="${c.photo}"
                                 alt="${c.username}"
                                 class="rounded-circle me-2"
                                 style="width: 40px; height: 40px; object-fit: cover;">
                            <span><strong>${c.username}</strong> je komentarisao/la vašu realizaciju - ${c.displayTask}, ${c.activity}</span>
                        </div>
                       <span class="remove-comment-icon-realization" title="Ukloni">&times;</span>
                    </div>
                    <small class="text-muted mb-1 d-block">${c.createdAtFormatted}</small>
                    <div>${c.comment}</div>
                </div>
            `;
            container.append(html);
        });
    }
        function renderPlanPieChart(stats) {
            if (!stats || Object.keys(stats).length === 0) return;

            const chartContainer = $('#plannedChartsContainer');

            // Ako canvas već postoji, ne kreiramo novi
            let canvas = document.getElementById('planPieChart');
            if (!canvas) {
                chartContainer.empty();
                chartContainer.append('<canvas id="planPieChart" style="width:100%; max-width:320px;"></canvas>');
                canvas = document.getElementById('planPieChart');
            }

            const ctx = canvas.getContext('2d');
            const total = Object.values(stats).reduce((a, b) => a + b, 0);

            if (planPieChart) planPieChart.destroy();

            planPieChart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: Object.keys(stats),
                    datasets: [{
                        data: Object.values(stats),
                        backgroundColor: ['#FF6384','#36A2EB','#FFCE56','#4BC0C0','#9966FF','#FF9F40']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: true, position: 'bottom' },
                        datalabels: {
                            color: '#fff',
                            formatter: value => !total ? '0%' : ((value/total)*100).toFixed(1)+'%',
                            font: { weight: 'bold', size: 14 }
                        }
                    }
                },
                plugins: [ChartDataLabels]
            });
        }
        function renderRealizationPieChart(stats) {
            if (!stats || Object.keys(stats).length === 0) return;

            const chartContainer = $('#realizedChartsContainer');

            // Ako canvas već postoji, ne kreiramo novi
            let canvas = document.getElementById('realizationPieChart');
            if (!canvas) {
                chartContainer.empty();
                chartContainer.append('<canvas id="realizationPieChart" style="width:100%; max-width:320px;"></canvas>');
                canvas = document.getElementById('realizationPieChart');
            }

            const ctx = canvas.getContext('2d');
            const total = Object.values(stats).reduce((a, b) => a + b, 0);

            if (realizationPieChart) realizationPieChart.destroy();

            realizationPieChart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: Object.keys(stats),
                    datasets: [{
                        data: Object.values(stats),
                        backgroundColor: ['#FF6384','#36A2EB','#FFCE56','#4BC0C0','#9966FF','#FF9F40']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: true, position: 'bottom' },
                        datalabels: {
                            color: '#fff',
                            formatter: value => !total ? '0%' : ((value/total)*100).toFixed(1)+'%',
                            font: { weight: 'bold', size: 14 }
                        }
                    }
                },
                plugins: [ChartDataLabels]
            });
        }
        function loadEmployeePlannings(employeeId) {
            $.ajax({
                url: "@Url.RouteUrl(RouteNames.TasksPlannings_Search)",
                method: "POST",
                data: {
                    employeeId: employeeId,
                    planDate: '@Model.Today'
                },
                success: function(data) {
                    const tbodyContainer = $('#plannedTablesContainer');
                    tbodyContainer.empty();

                    let stats = {};

                    if (data && data.length) {
                        let tableHtml = `
                            <table class="table table-modern">
                                <thead>
                                    <tr>
                                        <th class="col-activity">@localizer["Your task"]</th>
                                        <th class="col-activity">@localizer["Activity"]</th>
                                        <th class="col-from">@localizer["Time from"]</th>
                                        <th class="col-to">@localizer["Time to"]</th>
                                        <th class="col-duration">@localizer["Duration"]</th>
                                        <th class="col-order">@localizer["Id"]</th>
                                        <th style="width:30px;">@localizer["Finished"]</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        `;
                        tbodyContainer.append(tableHtml);
                        const tbody = tbodyContainer.find('tbody');

                        data.forEach(item => {
                            let finishedIcon = item.isFinished === null ? '-' :
                                               item.isFinished === true ? '<span style="color:green;font-weight:bold;">✔</span>' :
                                               '<span style="color:red;font-weight:bold;">✖</span>';

                            let row = `
                                <tr data-id="${item.id}">
                                    <td>${item.displayTask ?? ""}</td>
                                    <td>${item.activityName ?? ""}</td>
                                    <td>${item.timeFromFormatted ?? ""}</td>
                                    <td>${item.timeToFormatted ?? ""}</td>
                                    <td>${item.durationFormatted ?? ""}</td>
                                    <td>${item.planNo ?? ""}</td>
                                    <td class="text-center">${finishedIcon}</td>
                                </tr>
                            `;
                            tbody.append(row);

                            let type = item.activityTypeName ?? "Unknown";
                            stats[type] = (stats[type] || 0) + 1;
                        });
                        renderPlanPieChart(stats);

                    } else {
                        tbodyContainer.append('<div class="text-center">Nema podataka za ovog zaposlenog.</div>');
                    }
                },
                error: function(err) {
                    console.error('Greška pri učitavanju realizacija:', err);
                }
            });
        }
