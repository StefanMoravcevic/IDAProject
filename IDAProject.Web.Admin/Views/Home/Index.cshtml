                cancelButtonText: '@localizer["Cancel"]'
            }).then((result) => {

                if (result.isConfirmed) {

                    $.ajax({
                        url: '@Url.RouteUrl(RouteNames.EmployeeViewTrackings_Hide)',
                        method: 'POST',
                        data: { id: trackingId },
                        success: function () {

                            $(`.tracked-employee[data-trackingid='${trackingId}']`)
                                .fadeOut(200, function () { $(this).remove(); });

                            Swal.fire({
                                icon: 'success',
                                text: '@Html.Raw(localizer["Succesfully removed"])',
                                showConfirmButton: false,
                                timer: 1500
                            }).then(() => {
                                location.reload();
                            });
                        },
                        error: function (err) {
                            console.error("Greška pri uklanjanju:", err);

                            Swal.fire(
                                'Greška!',
                                'Došlo je do greške prilikom uklanjanja.',
                                'error'
                            );
                        }
                    });

                }
            });
        });

        $('#btnAddPhoto').click(function () {
            $('#inputPhotoFile').click();
        });

        $('#inputPhotoFile').change(function () {
            var file = this.files[0];
            if (!file) return;

            var formData = new FormData();
            formData.append("employeeId", @Model.EmployeeId);
            formData.append("PhotoFile", file);

            $.ajax({
                url: '@Url.RouteUrl(RouteNames.Employees_SavePhoto)', 
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.valid) {
                        location.reload();
                    } else {
                        alert('Greška: ' + response.message);
                    }
                },
                error: function () {
                    alert('Greška pri uploadu fajla.');
                }
            });
        });
        
    });
</script>
