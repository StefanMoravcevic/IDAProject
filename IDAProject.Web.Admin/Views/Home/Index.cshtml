<script>
    let planPieChart;
    let realizationPieChart;

    function loadEmployeesOnRoadTrip() {

        const currentEmployeeId = @Model.User.EmployeeId;

        // 1️⃣ Učitaj dozvole
        $.ajax({
            url: "@Url.RouteUrl(RouteNames.EmployeeJobTypeControls_Search)",
            method: "POST",
            data: { employeeId: currentEmployeeId },
            success: function (jobTypeControls) {

                if (!jobTypeControls || jobTypeControls.length === 0) {
                    $('#employeesOnRoadTrip').html('<div>Nema podataka</div>');
                    return;
                }

                const allowedJobTypeIds = jobTypeControls.map(j => j.jobTypeId);
                const allowedEmployeeIds = jobTypeControls.map(j => j.employeeToSeeId);

                // 2️⃣ Učitaj odsustva samo za dozvoljene zaposlene
                $.ajax({
                    url: '@Url.RouteUrl(RouteNames.EmployeeAbsences_Search)',
                    type: 'POST',
                    data: {
                        jobTypes: allowedJobTypeIds,
                        employees: allowedEmployeeIds,
                        isFromHomePage: true
                    },
                    success: function (data) {

                        if (!data || data.length === 0) {
                            $('#employeesOnRoadTrip').html('<div>Nema podataka</div>');
                            return;
                        }

                        // izbaci sebe
                        data = data.filter(x => x.employeeId !== currentEmployeeId);

                        if (data.length === 0) {
                            $('#employeesOnRoadTrip').html('<div>Nema podataka</div>');
                            return;
                        }

                        buildRoadTripTable(data);
                    },
                    error: function () {
                        console.error("Greška pri učitavanju odsustava");
                    }
                });
            },
            error: function () {
                console.error("Greška pri učitavanju job type kontrole");
            }
        });
    }

    function buildRoadTripTable(data) {

        let html = `
            <div class="table-responsive">
                <table class="table table-sm table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-center">
                            <th style="background-color:#f2b141; color:white;">@localizer["Employee"]</th>
                            <th style="background-color:#f2b141; color:white;">@localizer["Absence type"]</th>
                            <th style="background-color:#f2b141; color:white;">@localizer["Date from"]</th>
                            <th style="background-color:#f2b141; color:white;">@localizer["Date to"]</th>
                            <th style="background-color:#f2b141; color:white;">@localizer["Note"]</th>
                        </tr>
                    </thead>
                    <tbody>
        `;

        data.forEach(x => {
            html += `
                <tr>
                    <td>${x.employee}</td>
                    <td>${x.absenceType}</td>
                    <td>${(x.dateFromFormatted)}</td>
                    <td>${(x.dateToFormatted)}</td>
                    <td>${x.note ?? ""}</td>
                </tr>
            `;
        });

        html += `
                    </tbody>
                </table>
            </div>
        `;

        $('#employeesOnRoadTrip').html(html);
    }

    function loadEmployeesWithoutPlanNextWorkingDay(bookmarkedEmployeeIds) {
        if (!bookmarkedEmployeeIds || !bookmarkedEmployeeIds.length) {
            $('#employeesWithoutPlanList').html('<div>Nema bookmarkovanih zaposlenih.</div>');
            return;
        }

        $.ajax({
            url: '@Url.RouteUrl(RouteNames.EmployeeViewTrackings_GetBookmarkedEmployeesWithoutPlanNextWorkingDay)',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(bookmarkedEmployeeIds),
            success: function(response) {
                if (response && response.length) {
                    let html = '';
                    response.forEach(e => {
                        html += `
                            <div class="d-flex justify-content-between align-items-center"
                                 data-id="${e.viewedEmployeeId}"
                                 data-trackingid="${e.id}">
                                <span>${e.viewedEmployee}</span>
                            </div>
                        `;
                    });
                    $('#employeesWithoutPlanList').html(html);
                } else {
                    $('#employeesWithoutPlanList').html('<div>Svi bookmarkovani imaju plan za sledeći radni dan.</div>');
                }
            },
            error: function(err) {
                console.error('Greška pri učitavanju zaposlenih bez plana:', err);
                $('#employeesWithoutPlanList').html('<div>Došlo je do greške.</div>');
            }
        });
    }
    function loadPlanStatistics() {
        var employeeId = @Model.User.EmployeeId;
        $.ajax({
            url: '@Url.RouteUrl(RouteNames.TasksPlannings_GetStatsByEmployeeId, new { employeeId = @Model.User.EmployeeId })',
            method: 'GET',
            success: function(stats) {
                if (!stats) {
                    $('#planStatisticContainer').html('<div class="text-muted">Nema statistike.</div>');
                    return;
                }

                let percentage = stats.totalPlannedDays > 0
                    ? ((stats.plannedOnTimeDays / stats.totalPlannedDays) * 100).toFixed(2)
                    : 0;

                // Odredi boju procenta
                let percColor = percentage >= 80 ? 'text-success' :
                                percentage >= 50 ? 'text-warning' : 'text-danger';

                let html = `
                    <table class="table table-bordered table-striped mb-2 shadow-sm">
                        <thead class="table-light">
                            <tr class="text-center">
                                <th style="background-color:#f2b141; color:white;">@localizer["Planned on time"]</th>
                                <th style="background-color:#f2b141; color:white;">@localizer["Planned"]</th>
                                <th style="background-color:#f2b141; color:white;">@localizer["Planned % from sum"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="text-center align-middle">
                                <td class="fw-bold">${stats.plannedOnTimeDays}</td>
                                <td class="fw-bold">${stats.totalPlannedDays}</td>
                                <td class="${percColor} fw-bold">${percentage}%</td>
                            </tr>
                        </tbody>
                    </table>
                `;

                $('#planStatisticContainer').html(html);
            },
            error: function(err) {
                console.error('Greška pri učitavanju statistike:', err);
                $('#planStatisticContainer').html('<div class="text-danger">Greška pri učitavanju statistike.</div>');
            }
        });
    }
        function loadRealizationStatistics() {
        var employeeId = @Model.User.EmployeeId;
        $.ajax({
            url: '@Url.RouteUrl(RouteNames.TasksRealizations_StatsByEmployeeId, new { employeeId = @Model.User.EmployeeId })',
            method: 'GET',
            success: function(stats) {
                if (!stats) {
                    $('#realizationStatisticContainer').html('<div class="text-muted">Nema statistike.</div>');
                    return;
                }

                let html = `
                    <table class="table table-bordered table-striped mb-2 shadow-sm">
                        <thead class="table-light text-center">
                            <tr>
                                <th style="background-color:#f2b141; color:white;">@localizer["Total working days"]</th>
                                <th style="background-color:#f2b141; color:white;">@localizer["Days with realization"]</th>
                                <th style="background-color:#f2b141; color:white;">@localizer["Total work hours"]</th>
                                <th style="background-color:#f2b141; color:white;">@localizer["Total realization work hours"]</th>
                                <th style="background-color:#f2b141; color:white;">@localizer["Total logged hours"]</th>
                                <th style="background-color:#f2b141; color:white;">@localizer["Planned"]</th>
                                <th style="background-color:#f2b141; color:white;">@localizer["Unplanned"]</th>
                                <th style="background-color:#f2b141; color:white;">@localizer["Projects"]</th>
                                <th style="background-color:#f2b141; color:white;">@localizer["Tasks"]</th>
                                <th style="background-color:#f2b141; color:white;">@localizer["Regular"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="text-center align-middle">
                                <td class="fw-bold">${stats.totalWorkingDays}</td>
                                <td class="fw-bold">${stats.daysWithRealization}</td>
                                <td class="fw-bold">${stats.totalWorkHours}</td>
                                <td class="fw-bold">${stats.totalRealizationWorkHours}</td>
                                <td class="fw-bold">${stats.totalLoggedTimeFormatted}</td>
                                <td class="fw-bold">${stats.plannedCount} (${stats.plannedPercentage}%)</td>
