            background-color: #d9edf7; /* svetlo plava */
            color: #000000;
        }

        .notification-alert.group {
            background-color: #fcf8e3; /* svetlo žuta */
            color: #000000;
        }

    .comment-item {
        background-color: #ffffff;
        border-left: 4px solid #F2220F;
        border-radius: 0.25rem;
        padding: 0.5rem;
        transition: background-color 0.2s ease;
    }
    .comment-item-real {
        background-color: #ffffff;
        border-left: 4px solid #F5AE33;
        border-radius: 0.25rem;
        padding: 0.5rem;
        transition: background-color 0.2s ease;
    }

        .comment-item:hover {
            background-color: #f1f3f5; 
        }
        .comment-item-real:hover {
            background-color: #f1f3f5; 
        }

    .comments-card h6 {
        font-weight: 600;
        margin-bottom: 0.75rem;
    }

    .col-from, .col-to {
        width: 70px;
    }

    .col-duration {
        width: 70px;
    }

    .col-order {
        width: 50px;
    }

    .col-actions {
        width: 50px;
    }

    .col-status {
        width: 85px;
    }

    .remove-comment-icon {
        cursor: pointer;
        color: #F5AE33; /* tvoja boja */
        font-weight: bold;
        font-size: 1.5rem;
        transition: color 0.2s ease;
    }

        .remove-comment-icon:hover {
            color: #e07b00; /* tamnija nijansa pri hover-u */
        }
    .remove-comment-icon-realization {
        cursor: pointer;
        color: #F5AE33; /* tvoja boja */
        font-weight: bold;
        font-size: 1.5rem;
        transition: color 0.2s ease;
    }

        .remove-comment-icon-realization:hover {
            color: #e07b00; /* tamnija nijansa pri hover-u */
        }

    .tracked-employee {
        display: flex;
        align-items: center; /* elementi u jednoj liniji */
        justify-content: flex-start; /* ime levo */
        border: 1px solid #f08418;
        background-color: #ffffff;
        padding: 8px 12px;
        border-radius: 5px;
        cursor: pointer;
        margin-bottom: 8px; /* razmak između zaposlenih */
        transition: transform 0.2s, background-color 0.2s;
    }

        .tracked-employee:hover {
            background-color: #fdf1e0;
            transform: scale(1.02);
