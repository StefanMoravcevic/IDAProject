        function renderPlanPieChart(stats) {
            if (!stats || Object.keys(stats).length === 0) return;

            const chartContainer = $('#plannedChartsContainer');

            // Ako canvas već postoji, ne kreiramo novi
            let canvas = document.getElementById('planPieChart');
            if (!canvas) {
                chartContainer.empty();
                chartContainer.append('<canvas id="planPieChart" style="width:100%; max-width:320px;"></canvas>');
                canvas = document.getElementById('planPieChart');
            }

            const ctx = canvas.getContext('2d');
            const total = Object.values(stats).reduce((a, b) => a + b, 0);

            if (planPieChart) planPieChart.destroy();

            planPieChart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: Object.keys(stats),
                    datasets: [{
                        data: Object.values(stats),
                        backgroundColor: ['#FF6384','#36A2EB','#FFCE56','#4BC0C0','#9966FF','#FF9F40']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: true, position: 'bottom' },
                        datalabels: {
                            color: '#fff',
                            formatter: value => !total ? '0%' : ((value/total)*100).toFixed(1)+'%',
                            font: { weight: 'bold', size: 14 }
                        }
                    }
                },
                plugins: [ChartDataLabels]
            });
        }
