<link rel="stylesheet" type="text/css" href="~/lib/select2/select2.min.css" />
<script type="text/javascript" src="~/lib/select2/select2.min.js"></script>


<script type="text/javascript">
	var tableParams = {
		"searching": false,
		"fixedColumns": true,
		"autoWidth": true,
		"columnDefs": [
			{ "orderable": false, "targets": [2] }
		],
		"language": {
			"sEmptyTable": "Nema podataka u tabeli",
			"sInfo": "Prikazano _START_ do _END_ od _TOTAL_ unosa",
			"sInfoEmpty": "Prikazano 0 do 0 od 0 unosa",
			"sInfoFiltered": "(filtrirano od _MAX_ unosa)",
			"sInfoPostFix": "",
			"sSearch": "Pretraga:",
			"sUrl": "",
			"sLengthMenu": "Prikazivanje _MENU_ unosa",
			"oPaginate": {
				"sFirst": "Prva",
				"sPrevious": "Prethodna",
				"sNext": "Sledeća",
				"sLast": "Poslednja"
			}
		}
	};


	function bindIdaTasksTable()
	{
		$("#tableIdaTasks").on("click", "button[name='edit']", function () {

			var $row = $(this).closest("tr");

			var id = $(this).val();
			var name = $row.find("td:nth-child(1)").text();
			var dueDate = $row.find("td:nth-child(2)").text();


			 $("#idaTaskId").val(id);
			 $("#NameId").val(name);
			 $("#DueDateId").val(dueDate);
			 $("#idaTaskEmployeeId").val(@Model.UserId);

		});


		$("#tableIdaTasks").on("click", "button[name='delete']", function () {

			var id = $(this).val();

			Swal.fire({
				title: '@localizer["DeleteQuestion"]',
				showCancelButton: true,
				confirmButtonText: '@localizer["DeleteConfirmation"]'
			}).then((result) => {
				if (result.isConfirmed) {
					$.ajax({
						url: "@delUrl".replace("111", id),
						method: "DELETE",
						success: function (response) {

							handleActionResponseMessage(response, ajaxReloadIdaTaskTable, '@localizer["Error"]', '@localizer["DeletedMsg"]');
						},
					});
				}
			});
		});

	}

	function reloadIdaTaskTable() {
		$('#tableIdaTasks').DataTable(tableParams);
	}

	function ajaxReloadIdaTaskTable()
	{

		$.ajax({
			url: "@getUrl",
			method: "GET",
			success: function (htmlResponse) {
				$('#tableIdaTasks').DataTable().clear().destroy();
				$('#idaTasksWrapper').html(htmlResponse);
				setTimeout(reloadIdaTaskTable, 1000);
				bindIdaTasksTable();
				$("#idaTaskEmployeeId").val(@Model.UserId);
			}
		});
	}



	$(document).ready(function () {
		//  var input = document.getElementById('DateFromVehicleYellowCardId');
		// 	 var im = new Inputmask("99.99.9999");
		// 	 im.mask(input);
		// 	 var inputExDate = document.getElementById('DateToVehicleYellowCardId');
		// 	 var ed = new Inputmask("99.99.9999");
		// 	 ed.mask(inputExDate);
		// requiredSelect2('NewDriverYellowCardId');
		reloadIdaTaskTable();
		bindIdaTasksTable();
		 $("#@id input[type='text'][data-date='auto']").each(function (_, datePickerElement) {
			initDefaultDatePicker(datePickerElement);
		 });

		$("#idaTaskDataContainer button[name='save']").click(function () {
		$("#saveId").prop("disabled",true);
		var $inputsContainer = $("#idaTaskDataContainer");

		if (validateRequiredFields($inputsContainer, '@localizer["ValidationMsg"]')) {

			var jsonData = serializeJSON($inputsContainer);

			$.ajax({
				url: "@Url.RouteUrl(RouteNames.IdaTasks_Save)",
				method: "POST",
				data: jsonData,
				success: function (response) {
					handleActionResponseMessage(response, ajaxReloadIdaTaskTable, '@localizer["Error"]', '@localizer["SavedMsg"]');

					searchNotFinishedTasks();
					$inputsContainer.find("input, select, textarea").val('');


					$inputsContainer.find("tms-input").each(function() {
						$(this).val('');
					});
				}
				});
			}
			setInterval(function() {
				$("#saveId").prop("disabled", false);
			}, 2000);
		});

	});
</script>
