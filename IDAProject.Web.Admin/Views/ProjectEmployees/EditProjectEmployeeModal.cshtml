@model IDAProject.Web.Admin.Models.ViewModels.ProjectEmployees.ProjectEmployeeViewModel
@using IDAProject.Web.Admin.Models.Common;
@using IDAProject.Web.Helpers;
@using IDAProject.Web.Models.RequestModels.MasterData;
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> localizer
@addTagHelper IDAProject.Web.Admin.TagHelpers.*, IDAProject.Web.Admin
@{

	var id = DataHelpers.GetRandomHtmlId();
	var getUrl = Url.RouteUrl(RouteNames.ProjectEmployees_RecordsByProjectId, new { ProjectId = Model.ProjectId });
	var delUrl = Url.RouteUrl(RouteNames.ProjectEmployees_Delete, new { id = 111 });
}
<style>
	#tableVehicleAssignmentsByVehicle tbody tr td:first-child {
		cursor: pointer;
	}
</style>
<div id="@id">
	<div class="card">
		<div class="card-body">
			<div class="panel panel-primary">
				@* <div class="row">
					<div class="col-md-12 text-end">
						<button class="btn btn-link" type="button" data-bs-toggle="collapse" data-bs-target="#absenceCollapse" aria-expanded="true" aria-controls="absenceCollapse" style="background-color:white;">
							<i class="fa fa-expand" id="showContext" style="color:black;"></i>
						</button>
					</div>
				</div> *@
				<div class="row collapse show" id="absenceCollapse">
					<div class="col-lg-12 col-md-12" id="projectEmployeeDataContainer">
						<div class="card">
							<div class="card-header border-bottom">
								<h4 class="mb-0">@localizer["Enter project employee"]</h4>
							</div>
							<tms-input type="Hidden" name="Id" id="projectEmployeeId" />
							<tms-input type="Hidden" name="ProjectId" id="projectId" value="@Model.ProjectId" />
							<div class="card-body p-0 task-edit-main">
								<div class="row p-5 border-bottom">
									<div class="row search-params-wrapper">
										<div class="col-sm-12 col-md-12 col-xl-12">
											<tms-select name="EmployeeId" id="EmployeeId" options="@Model.Employees" label="@localizer["Employee"]" empty-option-text="@localizer["Select employee"]" />
										</div>
									</div>
								</div>
								<div class="row p-2">
									<div class="btn-list text-end">
										<button type="button" class="btn btn-primary" id="saveId" name="save">@localizer["Save"]</button>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="card">
				<div class="card-body">
					<div class="panel panel-primary" id="projectEmployeesWrapper">
						<partial name="EditProjectEmployeeRecords" model="@Model.ProjectEmployees" />
					</div>
				</div>
			</div>
		</div>
	</div>
</div>


<link rel="stylesheet" type="text/css" href="~/lib/select2/select2.min.css" />
<script type="text/javascript" src="~/lib/select2/select2.min.js"></script>


<script type="text/javascript">
	var tableParams = {
		"searching": false,
		"fixedColumns": true,
		"autoWidth": true,
		"columnDefs": [
			{ "orderable": false, "targets": [1] }
		],
		"language": {
			"sEmptyTable": "Nema podataka u tabeli",
			"sInfo": "Prikazano _START_ do _END_ od _TOTAL_ unosa",
			"sInfoEmpty": "Prikazano 0 do 0 od 0 unosa",
			"sInfoFiltered": "(filtrirano od _MAX_ unosa)",
			"sInfoPostFix": "",
			"sSearch": "Pretraga:",
			"sUrl": "",
			"sLengthMenu": "Prikazivanje _MENU_ unosa",
			"oPaginate": {
				"sFirst": "Prva",
				"sPrevious": "Prethodna",
				"sNext": "Sledeća",
				"sLast": "Poslednja"
			}
		}
	};


	function bindProjectEmployeesTable()
	{
		$("#tableProjectEmployees").on("click", "button[name='edit']", function () {

			var $row = $(this).closest("tr");

			var id = $(this).val();
			var employee = $row.find("td:nth-child(1)").text();

			var employeeId = $("#EmployeeId option").filter(function() {
				return $(this).text().trim() === employee.trim();
			}).val();
			$("#EmployeeId").val(employeeId).trigger("change");
			$("#projectEmployeeId").val(id);
			$("#projectId").val(@Model.ProjectId);

		});


		$("#tableProjectEmployees").on("click", "button[name='delete']", function () {

			var id = $(this).val();

			Swal.fire({
				title: '@localizer["DeleteQuestion"]',
				showCancelButton: true,
				confirmButtonText: '@localizer["DeleteConfirmation"]'
			}).then((result) => {
				if (result.isConfirmed) {
					$.ajax({
						url: "@delUrl".replace("111", id),
						method: "DELETE",
						success: function (response) {

							handleActionResponseMessage(response, ajaxReloadProjectEmployeesTable, '@localizer["Error"]', '@localizer["DeletedMsg"]');
						},
					});
				}
			});
		});

	}

	function reloadProjectEmployeesTable() {
		$('#tableProjectEmployees').DataTable(tableParams);
	}

	function ajaxReloadProjectEmployeesTable()
	{

		$.ajax({
			url: "@getUrl",
			method: "GET",
			success: function (htmlResponse) {
				$('#tableProjectEmployees').DataTable().clear().destroy();
				$('#projectEmployeesWrapper').html(htmlResponse);
				setTimeout(reloadProjectEmployeesTable, 1000);
				bindProjectEmployeesTable();
				$("#projectId").val(@Model.ProjectId);
			}
		});
	}



	$(document).ready(function () {
		$("#EmployeeId").select2({
			dropdownParent: $("#projectEmployeeDataContainer")
		});
		//  var input = document.getElementById('DateFromVehicleYellowCardId');
		// 	 var im = new Inputmask("99.99.9999");
		// 	 im.mask(input);
		// 	 var inputExDate = document.getElementById('DateToVehicleYellowCardId');
		// 	 var ed = new Inputmask("99.99.9999");
		// 	 ed.mask(inputExDate);
		// requiredSelect2('NewDriverYellowCardId');
		reloadProjectEmployeesTable();
		bindProjectEmployeesTable();
		 $("#@id input[type='text'][data-date='auto']").each(function (_, datePickerElement) {
			initDefaultDatePicker(datePickerElement);
		 });

		$("#projectEmployeeDataContainer button[name='save']").click(function () {
		$("#saveId").prop("disabled",true);
		var $inputsContainer = $("#projectEmployeeDataContainer");

		if (validateRequiredFields($inputsContainer, '@localizer["ValidationMsg"]')) {

			var jsonData = serializeJSON($inputsContainer);

			$.ajax({
				url: "@Url.RouteUrl(RouteNames.ProjectEmployees_Save)",
				method: "POST",
				data: jsonData,
				success: function (response) {
					handleActionResponseMessage(response, ajaxReloadProjectEmployeesTable, '@localizer["Error"]', '@localizer["SavedMsg"]');


					$inputsContainer.find("input, select, textarea").val('');


					$inputsContainer.find("tms-input").each(function() {
						$(this).val('');
					});

					$("#EmployeeId").val(null).trigger("change");
				}
				});
			}
			setInterval(function() {
				$("#saveId").prop("disabled", false);
			}, 2000);
		});

	});
</script>
