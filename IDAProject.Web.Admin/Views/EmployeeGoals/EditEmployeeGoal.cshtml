@model IDAProject.Web.Admin.Models.ViewModels.EmployeeGoals.EmployeeGoalViewModel
@using IDAProject.Web.Admin.Models.Common;
@using IDAProject.Web.Models.RequestModels.MasterData;
@using IDAProject.Web.Helpers;
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@addTagHelper IDAProject.Web.Admin.TagHelpers.*, IDAProject.Web.Admin
@inject IStringLocalizer<SharedResources> localizer
@{
	var goal = Model.EmployeeGoal;
	var urlList = Url.RouteUrl(RouteNames.EmployeeGoals_List);

}
<div class="card">
	<div class="card-body">
		<div class="panel panel-primary">
			<div class="row">
				<div class="col-lg-12 col-md-12" id="goalContainer">
					<div class="card">
						<div class="card-header border-bottom">
							<h4 class="mb-0">@localizer["Employe goal basic info"]</h4>
							<tms-input type="Hidden" name="Id" id="goalId" value="@goal.Id" />
						</div>
						<div class="card-body p-0 task-edit-main">
							<div class="row p-5 border-bottom">
								<div class="col-sm-12 col-md-6 col-xl-3">
									<tms-select name="YearId"
												id="YearId"
												options="@Model.Years"
												selected-option="@goal.YearId"
												label="@localizer["Year"]:"
												empty-option-text="@localizer["Select year"]..." />
								</div>
								<div class="col-sm-12 col-md-6 col-xl-3">
									<tms-select name="EmployeeId"
												id="EmployeeId"
												options="@Model.Employees"
												selected-option="@goal.EmployeeId"
												label="@localizer["Employee"]:"
												empty-option-text="@localizer["Select employee"]..." />
								</div>
								<div class="col-sm-6 col-md-6 col-xl-6 col-lg-6">
									<div class="form-group">
										<label class="form-label text-muted" for="Note">@localizer["Goal"]:</label>
										<div class="input-group">
											<textarea name="Goal" class="form-control text-dark" id="GoalId" style="height:120px;">@goal.Goal</textarea>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="card">
				<div class="row p-5">
					<div class="btn-list text-end">
						<button class="btn btn-outline-danger" id="buttonCancel">@localizer["Cancel"]</button>
						<button class="btn btn-primary" id="buttonSave">@localizer["Save"]</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>


@section Styles {
	<link rel="stylesheet" type="text/css" href="~/lib/select2/select2.min.css" />
}
@section Scripts {

	<script type="text/javascript" src="~/lib/select2/select2.min.js"></script>

	<script type="text/javascript">

		$(document).ready(function () {;
			if (@Model.ReadOnly == 1) {
				$("#goalContainer :input").prop("disabled", true);
				$("#buttonSave").prop("disabled", true);
			}

			$("#buttonSave").click(function () {
				var $inputsContainer = $("#goalContainer");

				if (validateRequiredFields($inputsContainer, '@localizer["ValidationMsg"]')) {
					var jsonData = serializeJSON($inputsContainer);

					$.ajax({
						url: "@Url.RouteUrl(RouteNames.EmployeeGoals_Save)",
						method: "POST",
						data: jsonData,
						success: function (response) {
							handleActionResponseMessage(response, function () {
								location = response.message;
							}, '@localizer["Error"]', '@localizer["SavedMsg"]');
						}
					});
				}
			});

			$("#buttonCancel").click(function () {
				document.location = '@urlList';
			});

			$("#EmployeeId").select2({});
			$("#YearId").select2({});
		});
	</script>
}