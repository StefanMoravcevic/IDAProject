@using IDAProject.Web.Admin.Models.Common;
@model IDAProject.Web.Admin.Models.ViewModels.NavigationBaseViewModel
@addTagHelper IDAProject.Web.Admin.TagHelpers.*, IDAProject.Web.Admin
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> localizer

@{
    ViewData["Title"] = "Login";
    Layout = "_LayoutLogin";
}

<tms-notification model="@Model.Notification" />

<div class="container">

    <div class="row justify-content-center py-5">

        <!-- LOGIN + INFO STACK -->
        <div class="col-12 col-md-6 col-lg-5">

            <!-- LOGIN CARD -->
            <div class="card shadow border-0 rounded-4 mb-4">

                <div class="card-body p-4">

                    <form method="post"
                          asp-route="@RouteNames.Accounts_DoLogin"
                          enctype="application/x-www-form-urlencoded">

                        <div class="text-center mb-3">
                            <img src="~/images/logoALPACK.png"
                                 style="max-width:150px;" />
                        </div>

                        <h4 class="text-center mb-4">
                            @localizer["LoginTitle"]
                        </h4>

                        <div class="mb-3">
                            <input class="form-control form-control-lg"
                                   type="text"
                                   name="Username"
                                   placeholder="@localizer["Username"]" />
                        </div>

                        <div class="mb-3">
                            <input class="form-control form-control-lg"
                                   type="password"
                                   name="Password"
                                   placeholder="@localizer["Password"]" />
                        </div>

                        <button type="submit"
                                class="btn btn-danger w-100 btn-lg">
                            @localizer["Login"]
                        </button>

                    </form>

                </div>
            </div>

            <!-- INFO CARD (ISPOD LOGIN-A) -->
            <div class="card shadow border-0 rounded-4">

                <div class="card-body p-4">

                    <h3 class="fw-bold">IDA Nova</h3>

                    <p class="text-muted">
                        Internal enterprise system used for employee planning,
                        task allocation and execution tracking within organizations.
                    </p>

                    <hr />

                    <h6>Purpose of data access</h6>
                    <p class="text-muted small">
                        This application may request access to user data
                        (such as calendar data) strictly for operational purposes.
                    </p>

                    <h6>Features</h6>
                    <ul class="text-muted small">
                        <li>Employee scheduling and planning</li>
                        <li>Task assignment and tracking</li>
                        <li>Google Calendar integration (if enabled)</li>
                    </ul>

                    <hr />

                    <div class="small">
                        <a href="@Url.RouteUrl(RouteNames.Home_Privacy)">Privacy Policy</a>
                        <span class="mx-2">|</span>
                        <a href="@Url.RouteUrl(RouteNames.Home_Terms)">Terms</a>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>