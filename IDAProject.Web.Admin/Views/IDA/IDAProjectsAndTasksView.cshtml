@model IDAProject.Web.Admin.Models.ViewModels.IDA.IDAViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using IDAProject.Web.Admin.Models.Common;
@using IDAProject.Web.Models.RequestModels.MasterData;
@using IDAProject.Web.Helpers;
@using IDAProject.Web.Admin.Models.TagHelpers;
@using IDAProject.Web.Admin.Models.TagHelpers.Base;
@using IDAProject.Web.Admin.TagHelpers.Base;
@inject IStringLocalizer<SharedResources> localizer
@addTagHelper IDAProject.Web.Admin.TagHelpers.*, IDAProject.Web.Admin
@{
    ViewData["Title"] = "IDA Viewers";
}
<style>
    .card-header {
        background-color: #F2220F !important; /* narandžasta boja */

    }

        .card-header .btn {
            color: white !important;
            font-weight: 900 !important;
            font-size: 18px !important;
    }
    .table thead {

        color: white; 
        font-weight: 900;
    }

    .select2-container {
        width: 100% !important;
    }

    .table tbody tr {
        transition: background-color 0.3s;
    }

    .table tbody tr:hover {
        background-color: #ffe5d1;
    }

    .table td, .table th {
        vertical-align: middle;
    }

    .card {
        border-radius: 0.5rem;
        border: 1px solid #ddd;
    }

    .table-responsive {
        max-height: 350px;
        overflow-y: auto;
    }

    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #fff7f0;
    }
</style>
<div class="container-fluid mt-1">

    <div class="card shadow-sm border-0 mb-2">
        <div class="card-body py-2 d-flex align-items-center justify-content-between">

            <h4 class="mb-0 fw-bold text-danger">
                <i class="fa fa-folder-open me-2"></i>
                @localizer["Projects and tasks view"]
            </h4>

        </div>
    </div>

</div>
<div class="container-fluid mt-4">
    <div class="row">

        <!-- My unfinished tasks -->
        <div class="col-12 col-md-3 mb-2">
            <div class="card shadow-sm">
                <div class="card-header p-0" id="headingMyTasks">
                    <button class="btn"
                            data-bs-toggle="collapse" data-bs-target="#collapseMyTasks"
                            aria-expanded="true" aria-controls="collapseMyTasks">
                        @localizer["My unfinished tasks"]
                    </button>
                </div>
                <div id="collapseMyTasks" class="collapse show" aria-labelledby="headingMyTasks">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped mb-0" id="myTasksTable">
                                <thead>
                                    <tr>
                                        <th>@localizer["Task"]</th>
                                        <th>@localizer["Due Date"]</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- My unfinished project tasks -->
        <div class="col-12 col-md-3 mb-2">
            <div class="card shadow-sm">
                <div class="card-header p-0" id="headingMyProjectTasks">
                    <button class="btn"
                            data-bs-toggle="collapse" data-bs-target="#collapseMyProjectTasks"
                            aria-expanded="true" aria-controls="collapseMyProjectTasks">
                        @localizer["My unfinished project tasks"]
                    </button>
                </div>
                <div id="collapseMyProjectTasks" class="collapse show" aria-labelledby="headingMyProjectTasks">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped mb-0" id="myProjectTasksTable">
                                <thead>
                                    <tr>
                                        <th>@localizer["Project"]</th>
                                        <th>@localizer["Task"]</th>
                                        <th>@localizer["Due Date"]</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- My finished tasks -->
        <div class="col-12 col-md-3 mb-2">
            <div class="card shadow-sm">
                <div class="card-header p-0" id="headingMyFinishedTasks" style="background-color:green !important">
                    <button class="btn"
                            data-bs-toggle="collapse" data-bs-target="#collapseMyFinishedTasks"
                            aria-expanded="true" aria-controls="collapseMyFinishedTasks">
                        @localizer["My finished tasks"]
                    </button>
                </div>
                <div id="collapseMyFinishedTasks" class="collapse show" aria-labelledby="headingMyFinishedTasks">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped mb-0" id="myFinishedTasksTable">
                                <thead>
                                    <tr>
                                        <th>@localizer["Task"]</th>
                                        <th>@localizer["Due Date"]</th>
                                        <th>@localizer["Completed date"]</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- My finished project tasks -->
        <div class="col-12 col-md-3 mb-2">
            <div class="card shadow-sm">
                <div class="card-header p-0" id="headingMyFinishedProjectTasks" style="background-color:green !important">
                    <button class="btn"
                            data-bs-toggle="collapse" data-bs-target="#collapseMyFinishedProjectTasks"
                            aria-expanded="true" aria-controls="collapseMyFinishedProjectTasks">
                        @localizer["My finished project tasks"]
                    </button>
                </div>
                <div id="collapseMyFinishedProjectTasks" class="collapse show" aria-labelledby="headingMyFinishedProjectTasks">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped mb-0" id="myFinishedProjectTasksTable">
                                <thead>
                                    <tr>
                                        <th>@localizer["Project"]</th>
                                        <th>@localizer["Task"]</th>
                                        <th>@localizer["Due Date"]</th>
                                        <th>@localizer["Completed date"]</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<div class="container-fluid mt-4">
    <div class="row g-3">
        <!-- Leva kolona: Projekti -->
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">@localizer["Select project you want to follow"]</h5>
                </div>
                <div class="card-body p-3">
                    <div class="col-12 col-md-6 col-xl-3">
                        <tms-select-multi name="ProjectId" id="ProjectId" options="@Model.Projects" label="@localizer["Projects"]:" />
                    </div>
                    <div id="projectTasks" class="mt-3 scrollable-x" style="overflow-x:auto;"></div>
                </div>
            </div>
        </div>

        <!-- Desna kolona: Zadaci -->
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">@localizer["Select employee and task you want to follow"]</h5>
                </div>
                <div class="card-body p-3">
                    <div class="row">
                        <div id="filterContainer">
                            <!-- Nema početnog filter seta -->
                        </div>

                        <div class="col-12 mb-3">
                            <button type="button" id="addFilterSet" class="btn btn-danger">@localizer["Add new choise"]</button>
                        </div>
                    </div>

                    <div id="tasks" class="mt-3 scrollable-x" style="overflow-x:auto;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
