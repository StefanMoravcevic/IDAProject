          function renderTasks(tasks, projectId) {
            var container = $('#projectTasks');

            if (!tasks || tasks.length === 0) {
                container.append('<div>No tasks found for project ID ' + projectId + '</div>');
                return;
            }

            // Kreiramo poseban div za svaki projekat
            var projectDiv = $('<div id="projectTasks_' + projectId + '" class="mb-4"></div>');

            // Naslov projekta
            var projectName = tasks[0].project || 'Project ' + projectId;
            projectDiv.append('<h5>' + projectName + '</h5>');

            // Tabela
            var table = $('<table class="table table-striped table-bordered"></table>');
            var thead = $('<thead><tr>' +
                '<th>@localizer["Project"]</th>' +
                '<th>@localizer["Due Date"]</th>' +
                '<th>@localizer["Employee"]</th>' +
                '<th>@localizer["Date"]</th>' +
                '<th>@localizer["Project task"]</th>' +
                '<th>@localizer["Due Date"]</th>' +
                '<th>@localizer["Activity"]</th>' +
                '<th>@localizer["Report"]</th>' +
                '<th>@localizer["IsCompleted"]</th>' +
                '<th>@localizer["Status"]</th>' +
                '</tr></thead>');

            table.append(thead);
            var tbody = $('<tbody></tbody>');

            tasks.forEach(function(t) {
                var row = $('<tr></tr>');
                row.append('<td>' + (t.project || '') + '</td>');
                row.append('<td>' + (t.projectDueDateFormatted || '') + '</td>');
                row.append('<td>' + (t.employee || '') + '</td>');
                row.append('<td>' + (t.planDateFormatted || '') + '</td>');
                row.append('<td>' + (t.name || '') + '</td>');
                row.append('<td>' + (t.dueDateFormatted || '') + '</td>');
                row.append('<td>' + (t.activity || '') + '</td>');
                row.append('<td>' + (t.report || '') + '</td>');
                row.append('<td>' + (t.isCompleted ? '✅' : '❌') + '</td>');
                row.append('<td>' + (t.status || '') + '</td>');
                tbody.append(row);
            });

            table.append(tbody);
            projectDiv.append(table);
            container.append(projectDiv); // dodajemo tabelu u glavni container
        }
        function renderTasksRightSide(tasks, taskId, employeeName, filterId) {
            var container = $('#tasks');

            if (!tasks || tasks.length === 0) {
                container.append('<div>No tasks found for task ID ' + taskId + '</div>');
                return;
            }

            var projectDiv = $('<div id="projectTasks_' + filterId + '_' + taskId + '" ' +
                'class="mb-4 task-table" data-task-id="' + taskId + '" data-filter-id="' + filterId + '"></div>');

            var projectName = tasks[0].name || 'Project ' + taskId;
            projectDiv.append('<h5>@localizer["Employee"]: ' + employeeName + ' | @localizer["Task"]: ' + projectName + '</h5>');

            var table = $('<table class="table table-striped table-bordered"></table>');
            var thead = $('<thead><tr>' +
                '<th>@localizer["Task"]</th>' +
                '<th>@localizer["Due Date"]</th>' +
                '<th>@localizer["Date"]</th>' +
                '<th>@localizer["Activity"]</th>' +
                '<th>@localizer["Report"]</th>' +
                '<th>@localizer["IsCompleted"]</th>' +
                '<th>@localizer["Status"]</th>' +
                '</tr></thead>');

            table.append(thead);
            var tbody = $('<tbody></tbody>');

            tasks.forEach(function(t) {
                var row = $('<tr></tr>');
                row.append('<td>' + (t.name || '') + '</td>');
                row.append('<td>' + (t.dueDateFormatted || '') + '</td>');
                row.append('<td>' + (t.planDateFormatted || '') + '</td>');
                row.append('<td>' + (t.activity || '') + '</td>');
                row.append('<td>' + (t.report || '') + '</td>');
                row.append('<td>' + (t.isCompleted ? '✅' : '❌') + '</td>');
                row.append('<td>' + (t.status || '') + '</td>');
                tbody.append(row);
            });

            table.append(tbody);
            projectDiv.append(table);
            container.append(projectDiv);
        }
        $(document).ready(function () {

            $("#ProjectId").select2({
                multiple: true,
                allowClear: true,
                placeholder: '@Html.Raw(localizer["Select project"])'
            });
            $("#EmployeeId").select2({
            });
            $("#IdaTaskId").select2({
                multiple: true,
                allowClear: true,
                placeholder: '@Html.Raw(localizer["Select task"])'
            });
            loadMyNotFinishedTasks();
            loadMyNotFinishedProjectTasks();
            loadMyFinishedTasks();
            loadMyFinishedProjectTasks();
            $(document).on('change', '#ProjectId', function () {

                var selectedProjects = $(this).val();
                var container = $('#projectTasks');

                container.empty(); // 🔥 obrišemo sve prethodne tabele

                if (!selectedProjects || selectedProjects.length === 0)
                    return;

                selectedProjects.forEach(function (projectId) {

                    $.ajax({
                        url: '@Url.RouteUrl(RouteNames.IdaTasks_GetTasksByProjectId, new { projectId = "__id__" })'
                                .replace('__id__', projectId),
                        type: 'GET',
                        success: function (response) {

                            // Ako backend vrati Payload ili direktno listu
                            var tasks = Array.isArray(response) ? response : response;

                            renderTasks(tasks, projectId);
                        },
                        error: function (err) {
                            console.error(err);
                            container.append(
                                '<div class="text-danger">Failed to load tasks for project ID '
                                + projectId + '</div>'
                            );
                        }
                    });

                });

            });

            $(document).on('change', '.IdaTaskId', function () {
                var selectedTasks = $(this).val() || [];
                var container = $('#tasks');

                var currentFilterId = $(this).attr('id').split('_')[1]; // npr. EmployeeId_2 → "2"
                var employeeName = $('#EmployeeId_' + currentFilterId + ' option:selected').text();

                // Ukloni tabele koje nisu više selektovane u ovom filter setu
                container.find(`.task-table[data-filter-id='${currentFilterId}']`).each(function () {
                    var taskId = $(this).data('task-id').toString();
                    if (!selectedTasks.includes(taskId)) {
                        $(this).remove();
                    }
                });

                // Dodaj nove tabele samo za taskove koji još nemaju tabelu u ovom filter setu
                selectedTasks.forEach(function (taskId) {
                    if (container.find(`.task-table[data-filter-id='${currentFilterId}'][data-task-id='${taskId}']`).length === 0) {
                        $.ajax({
                            url: '@Url.RouteUrl(RouteNames.IdaTasks_GetTasksByTaskId, new { taskId = "__id__" })'
                                .replace('__id__', taskId),
                            type: 'GET',
                            success: function (response) {
                                var tasks = Array.isArray(response) ? response : response;
                                renderTasksRightSide(tasks, taskId, employeeName, currentFilterId);
                            },
                            error: function (err) {
                                console.error(err);
                                container.append(
                                    '<div class="text-danger">Failed to load tasks for task ID ' + taskId + '</div>'
                                );
                            }
                        });
                    }
                });
            });
            $(document).on('change', '.EmployeeId', function () {
                var employeeId = $(this).val();
                var currentFilterId = $(this).attr('id').split('_')[1]; // npr. EmployeeId_2 → "2"
                getTasksByEmployeeId(employeeId, `IdaTaskId_${currentFilterId}`);
            });
            
            let filterCount = 0;

            $('#addFilterSet').on('click', function() {
                filterCount++;

                const newFilter = $(`
                    <div class="filterSet row mb-3">
                        <!-- Zaposleni -->
                        <div class="col-12 col-md-6 mb-3">
                            <label for="EmployeeId_${filterCount}">Zaposleni:</label>
                            <select name="EmployeeId" class="EmployeeId form-select" id="EmployeeId_${filterCount}" style="width: 100%;">
                                <option value="">Izaberite radnika...</option>
                                @foreach (var emp in Model.Employees)
                                {
                                        <option value="@emp.Value">@emp.Description</option>
                                }
                            </select>
                        </div>

                        <!-- Zadaci -->
                        <div class="col-12 col-md-6 mb-3">
                            <label for="IdaTaskId_${filterCount}">Zadaci:</label>
                            <select name="IdaTaskId" class="IdaTaskId form-select" id="IdaTaskId_${filterCount}" multiple style="width: 100%;">
                                @foreach (var task in Model.Tasks)
                                {
                                        <option value="@task.Value">@task.Description</option>
                                }
                            </select>
                        </div>
                    </div>
                `);

                $('#filterContainer').append(newFilter);

                // Inicijalizacija Select2
                $(`#EmployeeId_${filterCount}`).select2({
                    placeholder: "Izaberite radnika",
                    width: '100%'
                });

                $(`#IdaTaskId_${filterCount}`).select2({
                    placeholder: "Izaberite zadatke",
                    width: '100%'
                });
            });
        });
    </script>
}