               $.ajax({
                   url: '@Url.RouteUrl(RouteNames.IdaTasks_Search)',
                   method: 'POST',
                   data: {
                       userId: @Model.User.Id,
                       hasProject: false,
                       isCompleted: false
                   },
                   success: function(response) {
                       var tbody = $('#myTasksTable tbody');
                       tbody.empty();

                       if (response && response.length > 0) {
                           response.forEach(function(task) {
                               var row = '<tr>' +
                                   '<td>' + task.name + '</td>' +
                                   '<td>' + task.dueDateFormatted + '</td>' +
                                   '</tr>';
                               tbody.append(row);
                           });
                       } else {
