        function getTasksByEmployeeId(employeeId, taskSelectId) {
            $.ajax({
                url: "@Url.RouteUrl(RouteNames.IdaTasks_Search)",
                method: "POST",
                data: {
                    employeeId: employeeId,
                    hasProject: false
                },
                success: function (response) {
                    var taskSelect = $(`#${taskSelectId}`);
                    taskSelect.empty(); // obriši stare opcije

                    if (!response || response.length === 0) {
                        taskSelect.trigger('change'); // refresh select2
                        return;
                    }

                    response.forEach(function (task) {
                        var option = new Option(task.name, task.id, false, false);
                        taskSelect.append(option);
                    });

                    taskSelect.trigger('change'); // refresh select2
                },
                error: function (err) {
                    console.error(err);
                }
            });
        }
