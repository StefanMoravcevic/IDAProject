		function loadTasksForManualTable() {

			let date = $("#planDate").val();

			if (!date) {
				return;
			}

			let parts = date.split(".");
			let selectedDate = new Date(parts[2], parts[1] - 1, parts[0]);

			let today = new Date();
			today.setHours(0,0,0,0);

			let allowEdit = selectedDate > today;

			// if (allowEdit) {
			// 	$("#btnAddRow").show();
			// } else {
			// 	$("#btnAddRow").hide();
			// }

			$.ajax({
				url: "@Url.RouteUrl(RouteNames.TasksPlannings_Search)",
				method: "POST",
				data: {
					planDate: date,
					userId: @Model.User.Id
				},
				success: function (tasks) {

					let tbody = $("#manualTable tbody");
					tbody.empty();

					tasks.forEach(function (task) {

						let editBtn = allowEdit
							? `
								<button class="btn btn-sm btn-primary editTaskBtn">
									<i class="fa fa-pencil"></i>
								</button>

								<button class="btn btn-sm btn-danger deleteTaskBtn">
									<i class="fa fa-trash"></i>
								</button>
							  `
							: `
								<button class="btn btn-sm btn-primary" disabled>
									<i class="fa fa-pencil"></i>
								</button>

								<button class="btn btn-sm btn-danger" disabled>
									<i class="fa fa-trash"></i>
								</button>
							  `;


						let rowHtml = `
							<tr data-id="${task.id}">

								<td class="">
									${task.activityTypeName}
								</td>

								<td class="">
									${task.displayTask ?? ""}
								</td>

								<td class="">
									${task.activityName ?? ""}
								</td>

								<td class="">
									${task.timeFromFormatted}
								</td>

								<td class="">
									${task.timeToFormatted}
								</td>

								<td class="">
									${task.durationFormatted}
								</td>

								<td class="">
									${task.planNo ?? ""}
								</td>

								<td class="">
									${task.planStatus ?? ""}
								</td>

								<td class="">
									${editBtn}
								</td>

							</tr>
						`;

						tbody.append(rowHtml);
		

					});
					if ($(window).width() < 768)
					 {
						$("#btnAddRow").show();
					 }
					 else
					 {
						$("#btnAddRow").hide();
						addEmptyRow();
					 }

				},
				error: function (err) {
					console.error(err);
				}
			});
		}
