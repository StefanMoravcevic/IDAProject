		function loadTasksForManualTable() {

			let mode = $("#activityMode").val();
			let date = $("#planDate").val();

			if (!mode || !date) {
				return;
			}

			let parts = date.split(".");
			let selectedDate = new Date(parts[2], parts[1]-1, parts[0]);

			let today = new Date();
			today.setHours(0,0,0,0);

			let allowEdit = selectedDate > today;

			if (allowEdit) {
				$("#btnAddRow").show();
			} else {
				$("#btnAddRow").hide();
			}

			$.ajax({
				url: "@Url.RouteUrl(RouteNames.TasksPlannings_Search)",
				method: "POST",
				data: {
					activityTypeId: mode,
					planDate: date,
					userId : @Model.User.Id
				},
				success: function (tasks) {

					let tbody = $("#manualTable tbody");
					tbody.empty();

					tasks.forEach(function (task) {

						let editBtn = allowEdit
							? `<button class="btn btn-sm btn-primary editTaskBtn"><i class="fa fa-pencil"></i></button>`
							: `<button class="btn btn-sm btn-primary" disabled><i class="fa fa-pencil"></i></button>`;

						let rowHtml = "";

						if (mode === "1") {
							rowHtml = `
								<tr data-id="${task.id}">
									<td class="col-project">${task.project}</td>
									<td class="col-task">${task.task}</td>
									<td class="col-activity">${task.activityName}</td>
									<td class="col-from">${task.timeFromFormatted}</td>
									<td class="col-to">${task.timeToFormatted}</td>
									<td class="col-duration">${task.durationFormatted}</td>
									<td class="col-order">${task.planNo}</td>
									<td class="col-status">${task.planStatus}</td>
									<td class="col-actions">
										${editBtn}
									</td>
								</tr>
							`;
						}

						if (mode === "2") {
							rowHtml = `
								<tr data-id="${task.id}">
									<td class="col-task">${task.task}</td>
									<td class="col-activity">${task.activityName}</td>
									<td class="col-from">${task.timeFromFormatted}</td>
									<td class="col-to">${task.timeToFormatted}</td>
									<td class="col-duration">${task.durationFormatted}</td>
									<td class="col-order">${task.planNo}</td>
									<td class="col-status">${task.planStatus}</td>
									<td class="col-actions">
										${editBtn}
									</td>
								</tr>
							`;
						}

						if (mode === "3") {
							rowHtml = `
								<tr data-id="${task.id}">
									<td class="col-regular-activity">${task.regularActivity}</td>
									<td class="col-activity">${task.activityName}</td>
									<td class="col-from">${task.timeFromFormatted}</td>
									<td class="col-to">${task.timeToFormatted}</td>
									<td class="col-duration">${task.durationFormatted}</td>
									<td class="col-order">${task.planNo}</td>
									<td class="col-status">${task.planStatus}</td>
									<td class="col-actions">
										${editBtn}
									</td>
								</tr>
							`;
						}

						tbody.append(rowHtml);

					});

				},
				error: function (err) {
					console.error(err);
				}
			});
		}
