			function getLastPlanNo(callback) {

				$.ajax({
					url: "@Url.RouteUrl(RouteNames.TasksPlannings_Search)",
					method: "POST",
					data: {
						planDateForRowNumber: $("#planDate").val(),
						userId: "@Model.User.Id"
					},
					success: function (data) {

						let last = 0;

						if (data && data.length > 0) {
							last = Math.max(...data.map(x => parseInt(x.planNo) || 0));
						}

						callback(last);
					},
					error: function () {
						callback(0);
					}
				});
			}

		function searchTaskPlanningsPopulateTable() {

			$.ajax({
				url: "@Url.RouteUrl(RouteNames.TasksPlannings_Search)",
				method: "POST",
				data: {
					planDate: "@Model.Today",
					userId: "@Model.User.Id"
				},
				success: function (data) {

					let tbody = $("#plannedTable tbody");
					tbody.empty();

					let stats = {};

					$.each(data, function (index, item) {

						let finishedIcon = '';
						if (item.isFinished === null) finishedIcon = '-';
						else if (item.isFinished === true) finishedIcon = '<span style="color:green; font-weight:bold;">✔</span>';
						else finishedIcon = '<span style="color:red; font-weight:bold;">✖</span>';

						let rowClass = item.googleEventId ? 'google-event-row' : '';
						let googleLink = item.googleEventLink ?? '';

						let row = `
						<tr data-id="${item.id}" class="tooltip-target ${rowClass}" data-google-link="${googleLink}">
							<td>${item.displayTask ?? ""}</td>
							<td>${item.activityName ?? ""}</td>
							<td>${item.timeFromFormatted}</td>
							<td>${item.timeToFormatted}</td>
							<td>${item.durationFormatted ?? ""}</td>
							<td>${item.planStatus}</td>
							<td>${item.planNo ?? ""}</td>
							<td class="text-center">${finishedIcon}</td>
							<td style="text-align:center;"><i class="fa fa-comment" style="cursor:pointer;" data-type="plan"></i></td>s
						</tr>`;

						tbody.append(row);

						let type = item.activityTypeName ?? "Unknown";
						stats[type] = (stats[type] || 0) + 1;
					});

					renderPlanPieChart(stats);

					$("#plannedTable tbody tr.google-event-row").off("click").on("click", function () {
						const link = $(this).data("google-link");
						if (link) {
							window.open(link, "_blank");
						}
					});
				},
				error: function (err) {
					console.log(err);
				}
			});
		}

