			$('#inputPhotoFile').change(function () {
				var file = this.files[0];
				if (!file) return;

				var formData = new FormData();
				formData.append("employeeId", @Model.User.EmployeeId);
				formData.append("PhotoFile", file);

				$.ajax({
					url: '@Url.RouteUrl(RouteNames.Employees_SavePhoto)',
					type: 'POST',
					data: formData,
					processData: false,
					contentType: false,
					success: function (response) {
						if (response.valid) {
							location.reload();
						} else {
							alert('Greška: ' + response.message);
						}
					},
					error: function () {
						alert('Greška pri uploadu fajla.');
					}
				});
			});

			$(document).on("change", "#planDate, input[name='SelectedShiftId']", function () {

				const selectedDate = $("#planDate").val();
				const selectedShiftId = $("input[name='SelectedShiftId']:checked").val();
				debugger
				if (!selectedDate || !selectedShiftId)
					return;

				const parts = selectedDate.split(".");
				if (parts.length !== 3) return;

				const dateObj = new Date(parts[2], parts[1] - 1, parts[0]);

				// današnji datum (bez vremena)
				const today = new Date();
				today.setHours(0, 0, 0, 0);
				dateObj.setHours(0, 0, 0, 0);

				// samo ako je datum u budućnosti
				if (dateObj <= today)
					return;

				$.ajax({
					url: "@Url.RouteUrl(RouteNames.TasksPlannings_CreateByShift)",
					method: "POST",
					data: {
						date: selectedDate,
						shiftId: selectedShiftId
					},
					success: function (response) {
					}
				});
			});

			$(document).on("click", ".deleteTaskBtn", function () {

				let row = $(this).closest("tr");
				let id = row.data("id");

				Swal.fire({
					title: 'Delete task?',
					text: 'Are you sure you want to delete this task?',
					icon: 'warning',
					showCancelButton: true,
					confirmButtonText: 'Yes',
					cancelButtonText: 'Cancel'
				}).then((result) => {

					if (result.isConfirmed) {

						$.ajax({
							url: '@Url.RouteUrl(RouteNames.TasksPlannings_Delete, new { id = "111"})'.replace("111", id),
							type: 'POST',
							success: function (response) {

								if (response.valid) {

									Swal.fire({
										icon: 'success',
										title: 'Deleted successfully',
										timer: 1200,
										showConfirmButton: false
									});

									loadTasksForManualTable();

								} else {

									Swal.fire({
										icon: 'error',
										title: response.message
									});
								}
							},
							error: function () {

								Swal.fire({
									icon: 'error',
									title: 'Error while deleting'
								});
							}
						});
					}
				});
			});




