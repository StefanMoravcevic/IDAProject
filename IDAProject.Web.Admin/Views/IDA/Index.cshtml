			$(document).on("change", "#addRealizedRowModal .plan-no", function () {
				let planNo = $(this).val();
				if (!planNo) return;

				let modalBody = $("#addRealizedRowModal .modal-body");

				$.ajax({
					url: '@Url.RouteUrl(RouteNames.TasksPlannings_GetById, new { id = "111" })'.replace("111", planNo),
					method: 'GET',
					success: function (res) {
						if (!res) return;

						// Popuni Activity Type
						let activityTypeSelect = modalBody.find("select[name='ActivityTypeId']");
						activityTypeSelect.val(res.activityTypeId).trigger("change"); // trigger da okine updateColumnsByActivityTypeModal

						// Reset zavisne dropdownove
						modalBody.find("select[name='ProjectId'], select[name='IdaTaskId'], select[name='RegularActivityId']").val("");

						// Popuni dropdownove po tipu
						if (res.activityTypeId == 1) {
							modalBody.find("select[name='ProjectId']").val(res.projectId);
							modalBody.find("select[name='IdaTaskId']").val(res.taskId);
						} else if (res.activityTypeId == 2) {
							modalBody.find("select[name='IdaTaskId']").val(res.taskId);
						} else if (res.activityTypeId == 3) {
							modalBody.find("select[name='RegularActivityId']").val(res.regularActivityId);
						}

						// Ostala polja
						modalBody.find("textarea[name='Activity']").val(res.activityName);
						modalBody.find("textarea[name='Report']").val(res.report || "");
						// modalBody.find("input[name='TimeFromFormatted']").val(res.timeFrom);
						// modalBody.find("input[name='TimeToFormatted']").val(res.timeTo);
						// modalBody.find("input[name='DurationFormatted']").val(res.duration);
					}
				});
			});


			function updateColumnsByActivityTypeModal(activityTypeId, modalBody) {
				modalBody.find("div.col-project, div.col-task, div.col-regular").hide();

				if (activityTypeId == 1) {
					modalBody.find("select[name='ProjectId'], select[name='IdaTaskId']").val("");
					modalBody.find("div.col-project, div.col-task").show();

					let taskSelect = modalBody.find("select[name='IdaTaskId']");
					let options = `<option value="">@localizer["Select task"]</option>` +
						projectTasks.map(x => `<option value="${x.Value}">${x.Description}</option>`).join('');
					taskSelect.html(options);

				} else if (activityTypeId == 2) {
					modalBody.find("select[name='IdaTaskId']").val("");
					modalBody.find("div.col-task").show();

					let taskSelect = modalBody.find("select[name='IdaTaskId']");
					let options = `<option value="">@localizer["Select task"]</option>` +
						tasks.map(x => `<option value="${x.Value}">${x.Description}</option>`).join('');
					taskSelect.html(options);

				} else if (activityTypeId == 3) { 
					modalBody.find("select[name='RegularActivityId']").val("");
					modalBody.find("div.col-regular").show();
				}
			}
				$("#addRealizedRowModal").on("shown.bs.modal", function () {
				let modalBody = $(this).find(".modal-body");

				modalBody.off("change.duration").on("change.duration", "input[name='TimeFromFormatted'], input[name='TimeToFormatted']", function () {
					let from = modalBody.find("input[name='TimeFromFormatted']").val();
					let to = modalBody.find("input[name='TimeToFormatted']").val();
					modalBody.find("input[name='DurationFormatted']").val(calculateModalDuration(from, to));
				});
			});

