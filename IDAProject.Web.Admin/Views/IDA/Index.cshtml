@model IDAProject.Web.Admin.Models.ViewModels.IDA.IDAViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using IDAProject.Web.Admin.Models.Common;
@using IDAProject.Web.Models.RequestModels.MasterData;
@using IDAProject.Web.Helpers;
@using IDAProject.Web.Admin.Models.TagHelpers;
@using IDAProject.Web.Models.General.Enums;
@using IDAProject.Web.Admin.Models.TagHelpers.Base;
@using IDAProject.Web.Admin.TagHelpers.Base;
@inject IStringLocalizer<SharedResources> localizer
@addTagHelper IDAProject.Web.Admin.TagHelpers.*, IDAProject.Web.Admin
@{
	ViewData["Title"] = "IDA";
	var planNewDay = Url.RouteUrl(RouteNames.IDA_PlanNewDay);
	var employeePlaceholderParam = new { employeeId = 111 };
	var urlPatternAbsences = Url.RouteUrl(RouteNames.EmployeeAbsences_ListByEmployeeId, employeePlaceholderParam);
	var urlPatternIdaTasks = Url.RouteUrl(RouteNames.IdaTasks_GetByEmployeeId, new { userId = "111"});
	var urlPatternIdaProjectTasks = Url.RouteUrl(RouteNames.IdaProjectTasks_GetByEmployeeId, new { userId = "111"});
	var urlPatternRegularActivities = Url.RouteUrl(RouteNames.RegularActivities_GetByEmployeeId, new { userId = "111"});
	var date = Model.NextDay; // tvoj datum
	var danUNedelji = date.Value.ToString("dddd", new System.Globalization.CultureInfo("sr-Latn-RS"));
	var datumFormatirano = date.Value.ToString("dd.MM.yyyy");
	var urlLogout = Url.RouteUrl(RouteNames.Accounts_Logout);

}
<style>
	.page-main::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.5); /* 0.5 = jačina tame */

		z-index: 0;
	}

	.page-main {
		position: relative;
	}

		.page-main::before {
			pointer-events: none;
			z-index: 0;
		}

	.card {
		border-radius: 12px;
	}

	.card-header {
		border-top-left-radius: 12px;
		border-top-right-radius: 12px;
	}

	.tooltip-target {
		cursor: pointer;
	}

	.table {
		font-size: 14px;
	}

		.table th {
			background: #f8f9fa;
		}

	.table-hover tbody tr:hover {
		background: #f1f5ff;
	}

	#manualTable {
		border-radius: 8px;
		overflow: hidden;
	}

	#manualTable {
		table-layout: fixed;
		width: 100%;
	}

	.custom-tooltip {
		position: absolute;
		background: #333;
		color: white;
		padding: 6px 10px;
		border-radius: 4px;
		font-size: 12px;
		display: none;
		z-index: 9999;
		pointer-events: none;
		white-space: nowrap;
	}
	#manualTable select.form-select {
		width: 100%;
	}
	
	.col-from, .col-to {
		width: 70px;
	}

	.col-duration {
		width: 70px;
	}

	.col-order {
		width: 50px;
	}
	.col-actions {
		width: 50px;
	}

	.col-status {
		width: 85px;
	}


	/* Osnovna visina inputa */
	td input[name="Activity"],
	td input[name="Report"] {
		transition: height 0.3s ease; /* glatka promena visine */
	}

		/* Kad input dobije fokus */
		td input[name="Activity"]:focus,
		td input[name="Report"]:focus {
			height: 75px; /* povećava se visina na fokus */
		}
	.google-event-row {
		background-color: #ccffff !important; /* svetloplava, možeš promeniti boju po želji */
	}


</style>
<tms-modal id="editAbsenceModal" title="@localizer["Absences"]" save-button="false" modal-size="@ModalSize.Large" />
<tms-modal id="editIdaTasksModal" title="@localizer["Tasks"]" save-button="false" modal-size="@ModalSize.Default" />
<tms-modal id="editIdaProjectTasksModal" title="@localizer["Project tasks"]" save-button="false" modal-size="@ModalSize.Default" />
<tms-modal id="editRegularActivitiesModal" title="@localizer["Regular activities"]" save-button="false" modal-size="@ModalSize.Default" />
<div class="modal fade" id="addRowModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">@localizer["Add Activity"]</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@localizer["Cancel"]</button>
				<button type="button" class="btn btn-primary" id="modalSaveRow">@localizer["Save"]</button>
			</div>
		</div>
	</div>
</div>
<div class="modal fade" id="addRealizedRowModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">@localizer["Add realization"]</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@localizer["Cancel"]</button>
				<button type="button" class="btn btn-primary" id="modalSaveRealizationRow">@localizer["Save"]</button>
			</div>
		</div>
	</div>
</div>
<div class="container-fluid mt-1">

	<div class="card shadow-sm border-0 mb-2">
		<div class="card-body py-2 d-flex align-items-center justify-content-between">

			<h4 class="mb-0 fw-bold text-danger">
				<i class="fa fa-calendar-check-o me-2"></i>
				@localizer["IDA"]
			</h4>

		</div>
	</div>

</div>
<div class="container-fluid mt-1 min-vh-100 d-flex flex-column">

	<div class="row g-2 align-items-stretch">

		<!-- LEVO: PLAN / TABELA (10 kolona) -->
		<div class="col-12 col-lg-10 d-flex">

			<div class="card shadow-lg border-0 rounded-3 flex-fill h-100">

				<div class="card-header btn-danger text-white fw-bold d-flex flex-wrap align-items-center gap-3 justify-content-between">

					<!-- LEFT: Datum -->
					<div class="d-flex align-items-center gap-2">
						<span id="planDayDisplay">
							📅 @localizer["Plans for day"] - @danUNedelji – @datumFormatirano
						</span>

						<tms-input type="Date"
								   id="planDate"
								   class="form-control form-control-sm w-auto"
								   value="@Model.NextDay" />
					</div>

					@if(Model.ShiftWork){
						<div class="d-flex align-items-center gap-3 flex-wrap">

							<span class="fw-bold text-white">
								@localizer["Shifts"]:
							</span>

							@foreach (var shift in Model.Shifts)
							{
								<div class="form-check form-check-inline m-0">
									<input class="form-check-input"
										   type="radio"
										   name="SelectedShiftId"
										   id="shift_@shift.Value"
										   value="@shift.Value" />

									<label class="form-check-label text-white fw-bold"
										   for="shift_@shift.Value">
										@shift.Description
									</label>
								</div>
							}

						</div>
					}

					<!-- RIGHT: Activity type -->
					<select id="activityMode"
							name="ActivityTypePlanId"
							class="form-select form-select-sm w-auto">

						<option value="">
							@localizer["Select activity type"]
						</option>

						<option value="1">@localizer["Project"]</option>
						<option value="2">@localizer["Task"]</option>
						<option value="3">@localizer["Regular activity"]</option>

					</select>

				</div>
				<div class="card-body p-3 d-flex flex-column">

					<div class="table-responsive flex-grow-1" style="overflow-x:auto !important;">

