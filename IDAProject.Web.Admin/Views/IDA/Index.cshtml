@model IDAProject.Web.Admin.Models.ViewModels.IDA.IDAViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using IDAProject.Web.Admin.Models.Common;
@using IDAProject.Web.Models.RequestModels.MasterData;
@using IDAProject.Web.Helpers;
@using IDAProject.Web.Admin.Models.TagHelpers;
@using IDAProject.Web.Models.General.Enums;
@using IDAProject.Web.Admin.Models.TagHelpers.Base;
@using IDAProject.Web.Admin.TagHelpers.Base;
@inject IStringLocalizer<SharedResources> localizer
@addTagHelper IDAProject.Web.Admin.TagHelpers.*, IDAProject.Web.Admin
@{
	ViewData["Title"] = "IDA";
	var planNewDay = Url.RouteUrl(RouteNames.IDA_PlanNewDay);
	var employeePlaceholderParam = new { employeeId = 111 };
	var urlPatternAbsences = Url.RouteUrl(RouteNames.EmployeeAbsences_ListByEmployeeId, employeePlaceholderParam);
	var urlPatternIdaTasks = Url.RouteUrl(RouteNames.IdaTasks_GetByEmployeeId, new { userId = "111"});
	var urlPatternIdaProjectTasks = Url.RouteUrl(RouteNames.IdaProjectTasks_GetByEmployeeId, new { userId = "111"});
	var urlPatternRegularActivities = Url.RouteUrl(RouteNames.RegularActivities_GetByEmployeeId, new { userId = "111"});
	var date = Model.NextDay; // tvoj datum
	var danUNedelji = date.Value.ToString("dddd", new System.Globalization.CultureInfo("sr-Latn-RS"));
	var datumFormatirano = date.Value.ToString("dd.MM.yyyy");
	var urlLogout = Url.RouteUrl(RouteNames.Accounts_Logout);

}
<style>
	.page-main::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.5); /* 0.5 = jačina tame */

		z-index: 0;
	}

	.page-main {
		position: relative;
	}

		.page-main::before {
			pointer-events: none;
			z-index: 0;
		}

	.card {
		border-radius: 12px;
	}

	.card-header {
		border-top-left-radius: 12px;
		border-top-right-radius: 12px;
	}

	.tooltip-target {
		cursor: pointer;
	}

	.table {
		font-size: 14px;
	}

		.table th {
			background: #f8f9fa;
		}

	.table-hover tbody tr:hover {
		background: #f1f5ff;
	}

	#manualTable {
		border-radius: 8px;
		overflow: hidden;
	}

	#manualTable {
		table-layout: fixed;
		width: 100%;
	}

	.custom-tooltip {
		position: absolute;
		background: #333;
		color: white;
		padding: 6px 10px;
		border-radius: 4px;
		font-size: 12px;
		display: none;
		z-index: 9999;
		pointer-events: none;
		white-space: nowrap;
	}
	#manualTable select.form-select {
		width: 100%;
	}
	
	.col-from, .col-to {
		width: 70px;
	}

	.col-duration {
		width: 70px;
	}

 	.col-order {
		width: 40px;
	}

	.col-actionsManual {
		width: 100px;
	}

	.col-statusManual {
		width:90px;
	}
	/* 
	

	.col-status {
		width: 85px;
	}
	.col-activity {
		width: 90px;
	}

	.col-activityDescription {
		width: 90px;
	}

	.col-regular-activity {
		width: 90px;
	}

	.col-task {
		width: 90px;
	}

	.col-project {
		width: 90px;
	}
	.col-type {
		width: 90px;
	}




	/* Osnovna visina inputa */
	td input[name="Activity"],
	td input[name="Report"] {
		transition: height 0.3s ease; /* glatka promena visine */
	}

		/* Kad input dobije fokus */
		td input[name="Activity"]:focus,
		td input[name="Report"]:focus {
			height: 75px; /* povećava se visina na fokus */
		}
	.google-event-row {
		background-color: #ccffff !important; /* svetloplava, možeš promeniti boju po želji */
	}


</style>
<div class="modal fade" id="commentsModal" tabindex="-1" aria-labelledby="commentsModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header bg-primary text-white">
				<h5 class="modal-title" id="commentsModalLabel">@localizer["Comment plan"]</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<div id="planInfo" class="mb-3 p-2"></div>
				<div id="commentsContainer"></div>

				<hr>
				<div class="mb-3">
					<label for="newCommentText" class="form-label">@localizer["Leave comment"]</label>
					<textarea class="form-control" id="newCommentText" rows="2"></textarea>
				</div>

				<button type="button" class="btn btn-primary" id="saveCommentBtn">@localizer["Save"]</button>
			</div>

		</div>
	</div>
</div>
<div class="modal fade" id="realizationCommentsModal" tabindex="-1" aria-labelledby="realizationCommentsModal" aria-hidden="true">
	<div class="modal-dialog modal-lg modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header bg-primary text-white">
				<h5 class="modal-title" id="commentsModalLabel">@localizer["Comment realization"]</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<div id="realizationInfo" class="mb-3 p-2"></div>
				<div id="relizationCommentsContainer">
				</div>

				<hr>
				<div class="mb-3">
					<label for="newRealizationText" class="form-label">@localizer["Leave comment"]</label>
					<textarea class="form-control" id="newRealizationText" rows="2"></textarea>
				</div>

				<button type="button" class="btn btn-primary" id="saveRelizationCommentBtn">@localizer["Save"]</button>
			</div>

		</div>
	</div>
</div>
<tms-modal id="editAbsenceModal" title="@localizer["Absences"]" save-button="false" modal-size="@ModalSize.Large" />
<tms-modal id="editIdaTasksModal" title="@localizer["Tasks"]" save-button="false" modal-size="@ModalSize.Default" />
<tms-modal id="editIdaProjectTasksModal" title="@localizer["Project tasks"]" save-button="false" modal-size="@ModalSize.Default" />
<tms-modal id="editRegularActivitiesModal" title="@localizer["Regular activities"]" save-button="false" modal-size="@ModalSize.Default" />
<div class="modal fade" id="addRowModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">@localizer["Add Activity"]</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@localizer["Cancel"]</button>
				<button type="button" class="btn btn-primary" id="modalSaveRow">@localizer["Save"]</button>
			</div>
		</div>
	</div>
</div>
<div class="modal fade" id="addRealizedRowModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">@localizer["Add realization"]</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@localizer["Cancel"]</button>
				<button type="button" class="btn btn-primary" id="modalSaveRealizationRow">@localizer["Save"]</button>
			</div>
		</div>
	</div>
</div>
<div class="container-fluid mt-1">

	<div class="card shadow-sm border-0 mb-2">
		<div class="card-body py-2 d-flex align-items-center justify-content-between">

			<h4 class="mb-0 fw-bold text-danger">
				<i class="fa fa-calendar-check-o me-2"></i>
				@localizer["IDA"]
			</h4>

		</div>
	</div>

</div>
<div class="container-fluid mt-1 min-vh-100 d-flex flex-column">

	<div class="row g-2 align-items-stretch">

		<!-- LEVO: PLAN / TABELA (10 kolona) -->
		<div class="col-12 col-lg-10 d-flex">

			<div class="card shadow-lg border-0 rounded-3 flex-fill h-100">

				<div class="card-header btn-danger text-white fw-bold d-flex flex-wrap align-items-center gap-3 justify-content-between">

					<!-- LEFT: Datum -->
					<div class="d-flex align-items-center gap-2">
						<span id="planDayDisplay">
							📅 @localizer["Plans for day"] - @danUNedelji – @datumFormatirano
						</span>

						<tms-input type="Date"
								   id="planDate"
								   class="form-control form-control-sm w-auto"
								   value="@Model.NextDay" />
					</div>

					@if(Model.ShiftWork){
						<div class="d-flex align-items-center gap-3 flex-wrap">

							<span class="fw-bold text-white">
								@localizer["Shifts"]:
							</span>

							@foreach (var shift in Model.Shifts)
							{
								<div class="form-check form-check-inline m-0">
									<input class="form-check-input"
										   type="radio"
										   name="SelectedShiftId"
										   id="shift_@shift.Value"
										   value="@shift.Value" />

									<label class="form-check-label text-white fw-bold"
										   for="shift_@shift.Value">
										@shift.Description
									</label>
								</div>
							}

						</div>
					}

					<!-- RIGHT: Activity type -->
					

				</div>
				<div class="card-body p-3 d-flex flex-column">

					<div class="table-responsive flex-grow-1" style="overflow-x:auto !important;">

						<table class="table table-hover table-bordered align-middle" id="manualTable">

							<thead id="dynamicTableHead" class="table-light">
								<tr>
									<th class="col-type">@localizer["Activity type"]</th>
									<th class="">@localizer["Task"]</th>
									<th class="col-activity">@localizer["Description"]</th>
									<th class="col-from">@localizer["Time from"]</th>
									<th class="col-to">@localizer["Time to"]</th>
									<th class="col-duration">@localizer["Duration"]</th>
									<th class="col-order">@localizer["Id"]</th>
									<th class="col-statusManual">@localizer["Status"]</th>
									<th class="col-actionsManual">@localizer["Actions"]</th>
								</tr>
							</thead>

							<tbody></tbody>

						</table>

					</div>

					<button class="btn btn-danger btn-sm px-3 mt-2 align-self-start"
							id="btnAddRow">
						@localizer["Add row"]
					</button>

				</div>

			</div>

		</div>

		<!-- DESNO: SLIKA + DUGMIĆI (2 kolone) -->
		<div class="col-12 col-lg-2 d-none-new d-lg-flex">

			<div class="card shadow-sm mb-3 flex-fill h-100">

				<div class="card-header bg-light fw-bold">
					@localizer["Users photo"]
				</div>

				<div class="card-body text-center">

					@if (!string.IsNullOrEmpty(Model.ImageSource))
					{
						<img src="@Model.ImageSource"
							 class=""
							 style="width:150px; height:150px; object-fit: contain;"
							 alt="Task image" />
					}
					else
					{
						<p class="text-muted">@localizer["No image available"]</p>
					}

					<div class="d-flex flex-column gap-2 mt-2">
						<a href="@urlLogout" class="btn btn-sm btn-danger fw-semibold">
							@localizer["Log out"]
						</a>

						<a href="~/manuals/IDA Korisničko uputstvo v2.pdf" class="btn btn-sm btn-danger fw-semibold">
							@localizer["Manual"]
						</a>

						<button type="button" class="btn btn-sm btn-danger fw-semibold" id="btnAddPhoto">
							@localizer["Add photo"]
						</button>

						<input type="file" id="inputPhotoFile" style="display:none" accept="image/*">
					</div>

				</div>

			</div>

		</div>

	</div>


	<div class="card shadow-sm mt-3 flex-grow-1 d-flex flex-column">

		<div class="card-header fw-bold"
			 id="activityHeader"
			 style="background-color:#F2220F;color:white;cursor:pointer;">

			📝 @localizer["Activities"]

		</div>


		<div class="card-body" id="activitiesBody">

			<!-- BUTTONS -->
			<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3">

				<!-- LEFT BUTTONS -->
				<div class="d-flex flex-wrap gap-2">

@* 					<button class="btn btn-primary btn-sm"
							id="btnPlanNewDay">
						🔄 @localizer["Plan new day"]
					</button> *@

					@if(Model.User.Roles.Contains(AspNetRoles.Odsustva.ToString()))
					{
						<button class="btn btn-danger btn-sm"
								id="btnEnterAbsence">
							📊 @localizer["Enter absence"]
						</button>
					}
				</div>

				<!-- RIGHT BUTTONS -->
				<div class="d-flex flex-wrap gap-2 ms-sm-auto">

					<button class="btn btn-danger btn-sm"
							id="btnAddTask">
						 @localizer["Add task"]
					</button>

					<button class="btn btn-danger btn-sm"
							id="btnAddProjectTask">
						📁 @localizer["Add project task"]
					</button>

					<button class="btn btn-danger btn-sm"
							id="btnAddRegularActivity">
						🔁 @localizer["Add regular activity"]
					</button>

				</div>

			</div>


			<div class="row g-3" id="activitiesContainer">

				<!-- PLAN -->
				<div class="col-12 col-xl-5">

					<h6 class="fw-bold">
						📌 @localizer["Yours today plans"] - @Model.TodayForActivityTable
					</h6>

					<div class="table-responsive">

						<table class="table table-modern"id="plannedTable">

							<thead>
								<tr class="text-center">

									<th class="col-activity" style="background-color:#f2b141; color:white;">@localizer["Your task"]</th>
									<th class="col-activityDescription" style="background-color:#f2b141; color:white;">@localizer["Description"]</th>
									<th class="col-from" style="background-color:#f2b141; color:white;">@localizer["Time from"]</th>
									<th class="col-to" style="background-color:#f2b141; color:white;">@localizer["Time to"]</th>
									<th class="col-duration" style="background-color:#f2b141; color:white;">@localizer["Duration"]</th>
									<th class="col-status" style="background-color:#f2b141; color:white;">@localizer["Status"]</th>
									<th class="col-order" style="background-color:#f2b141; color:white;">@localizer["Id"]</th>
									<th style="width:30px; background-color:#f2b141; color:white;">@localizer["Finished"]</th>
									<th style="width:30px; background-color:#f2b141; color:white;">@localizer["Comments"]</th>

								</tr>
							</thead>

							<tbody></tbody>

						</table>

					</div>


					<div class="mt-3 d-flex justify-content-center">

						<div class="w-100" style="max-width:320px;">

							<canvas id="planPieChart"></canvas>

						</div>

					</div>

				</div>



				<!-- REALISATION -->
				<div class="col-12 col-xl-7 border-start"
					 style="border-color:#ddd !important;">

					<h6 class="fw-bold">
						✅ @localizer["Yours today realisation"]  - @Model.TodayForActivityTable
					</h6>


					<div class="table-responsive">

						<table class="table table-modern"
							   id="realizedTable">

							<thead class="table-light">

								<tr class="text-center">

									<th style="background-color:#f2b141; color:white;" class="col-order">@localizer["Id"]</th>

									<th style="background-color:#f2b141; color:white;" class="col-activityType col-activity">
										@localizer["Activity type"]
									</th>

									<th style="background-color:#f2b141; color:white;" class="col-taskName col-activity">
										@localizer["Task"]
									</th>

									<th class="col-project col-activity"
										style="display:none; background-color:#f2b141; color:white;">
										@localizer["Project"]
									</th>

									<th class="col-task"
										style="display:none;background-color:#f2b141; color:white;">
										@localizer["Task"]
									</th>

									<th class="col-regular"
										style="display:none;background-color:#f2b141; color:white;">
										@localizer["Regular activity"]
									</th>

									<th style="background-color:#f2b141; color:white;">@localizer["Description"]</th>

									

									<th style="background-color:#f2b141; color:white;">@localizer["Report"]</th>

									<th style="background-color:#f2b141; color:white;" class="col-from">@localizer["Time from"]</th>
									<th style="background-color:#f2b141; color:white;" class="col-to">@localizer["Time to"]</th>

									<th style="background-color:#f2b141; color:white;" class="col-duration">@localizer["Duration"]</th>

									<th style="width:30px;background-color:#f2b141; color:white;">@localizer["Finished"]</th>

									<th class="col-actions"
										style="display:none;background-color:#f2b141; color:white;">
										@localizer["Actions"]
									</th>
									<th style="width:30px; background-color:#f2b141; color:white;">@localizer["Comments"]</th>

								</tr>

							</thead>

							<tbody></tbody>

						</table>

					</div>


					<button class="btn btn-danger btn-sm mt-2"
							id="btnAddRealRow">

						 @localizer["Add row"]

					</button>


					<div class="mt-3 d-flex justify-content-center">

						<div class="w-100"
							 style="max-width:320px;">

							<canvas id="realizationPieChart"></canvas>

						</div>

					</div>

				</div>

			</div>

		</div>

	</div>



</div>
<div id="customTooltip" class="custom-tooltip"></div>
@section Styles {
	<link rel="stylesheet" type="text/css" href="~/lib/select2/select2.min.css" />
}
@section Scripts {

	<script type="text/javascript" src="~/lib/select2/select2.min.js"></script>

	<script type="text/javascript">
			let planPieChart = null;
			let realizationPieChart = null;
			const activityTypes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActivityTypes));
			const projects = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Projects));
			const tasks = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tasks));
			const projectTasks = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProjectTasks));
			const statuses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PlanStatuses));
			const regularActivities = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RegularActivities));
			var plannedTasks = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TaskPlannings));

			const daniUNedelji = ["Nedelja", "Ponedeljak", "Utorak", "Sreda", "Četvrtak", "Petak", "Subota"];

		function openAddRowModal(item = null) {

			let modalBody = $("#addRowModal .modal-body");

			modalBody.empty();

			let html = `

				<!-- ACTIVITY TYPE -->
				<div class="mb-3">

					<label>@localizer["Activity type"]</label>

					<select class="form-select"
							name="ActivityTypeId" 
							id="modalActivityType">

						<option value="">
							@localizer["Select activity type"]
						</option>

						<option value="1">
							@localizer["Project activity"]
						</option>

						<option value="2">
							@localizer["Task"]
						</option>

						<option value="3">
							@localizer["Regular activity"]
						</option>

					</select>

				</div>

				<!-- DYNAMIC PART -->
				<div id="modalDynamicFields"></div>

				<!-- COMMON FIELDS -->
				<div id="modalCommonFields">

					<div class="mb-3">
						<label>@localizer["Activity"]</label>

						<input type="text"
							   class="form-control"
							   name="ActivityName">
					</div>

					<div class="mb-3">
						<label>@localizer["Time from"]</label>

						<input type="text"
							   class="form-control timepicker from-time"
							   name="TimeFromFormatted">
					</div>

					<div class="mb-3">
						<label>@localizer["Time to"]</label>

						<input type="text"
							   class="form-control timepicker to-time"
							   name="TimeToFormatted">
					</div>

					<div class="mb-3">
						<label>@localizer["Duration"]</label>

						<input type="text"
							   class="form-control duration"
							   name="DurationFormatted"
							   readonly>
					</div>

					<div class="mb-3">
						<label>@localizer["Plan No"]</label>

						<input type="number"
							   class="form-control"
							   name="PlanNo"
							   readonly>
					</div>

					<div class="mb-3">
						<label>@localizer["Status"]</label>

						<select class="form-select"
								name="PlanStatusId">

							@foreach (var s in Model.PlanStatuses)
							{
									<option value="@s.Value">
										@s.Description
									</option>
							}

						</select>
					</div>

				</div>
			`;

			modalBody.html(html);

			initTimePickers(modalBody);

				if (item) {

			$("#addRowModal").attr("data-edit-id", item.id);

			$("#modalActivityType").val(item.activityTypeId);

			renderModalDynamicFields(item.activityTypeId, item);

			modalBody.find("input[name='ActivityName']")
					 .val(item.activityName);

			modalBody.find("input[name='TimeFromFormatted']")
					 .val(item.timeFromFormatted);

			modalBody.find("input[name='TimeToFormatted']")
					 .val(item.timeToFormatted);

			modalBody.find("input[name='DurationFormatted']")
					 .val(item.durationFormatted);

			modalBody.find("input[name='PlanNo']")
					 .val(item.planNo);

			modalBody.find("select[name='PlanStatusId']")
					 .val(item.planStatusId);
		}
		else {

			$("#addRowModal").removeAttr("data-edit-id");

			modalBody.find("select[name='PlanStatusId']").val("1");

			getLastPlanNo(function (lastNo) {

				modalBody.find("input[name='PlanNo']")
						 .val(lastNo + 1);
			});
		}
					$(document).on("change", "input[name='TimeFromFormatted'], input[name='TimeToFormatted']", function () {

			let $input = $(this);
			let $container = null;

			if ($input.closest("tr").length) {
				$container = $input.closest("tr");
			}
			else if ($input.closest("#addRowModal").length) {
				$container = $input.closest(".modal-body");
			}
			else if ($input.closest("#addRealizedRowModal").length) {
				$container = $input.closest(".modal-body");
			}

			if (!$container || !$container.length) {
				return;
			}

			let from = $container.find("input[name='TimeFromFormatted']").val();
			let to = $container.find("input[name='TimeToFormatted']").val();

			$container.find("input[name='DurationFormatted']")
					  .val(calculateModalDuration(from, to));
		});

			$("#addRowModal").modal("show");
		}

