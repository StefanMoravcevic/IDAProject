			$(document).on("change", ".plan-no", function () {

				let planNo = $(this).val();
				if (!planNo) return;

				// 🔥 Detekcija konteksta
				let container;

				if ($(this).closest("tr").length) {
					// desktop tabela
					container = $(this).closest("tr");
				} else {
					// modal
					container = $("#addRealRowModal .modal-body");
				}

				$.ajax({
					url: '@Url.RouteUrl(RouteNames.TasksPlannings_GetById, new { id = "111" })'.replace("111", planNo),
					method: 'GET',
					success: function (res) {

						if (!res) return;

						// ========================
						// Activity type
						// ========================
						let activityTypeSelect = container.find("select[name='ActivityTypeId']");
						activityTypeSelect.val(res.activityTypeId).trigger("change");

						// Reset dropdownove
						container.find("select[name='IdaTaskId'], select[name='ProjectId'], select[name='RegularActivityId']").val("");

						// ========================
						// Popunjavanje po tipu
						// ========================
						if (res.activityTypeId == 1) {
							container.find("select[name='ProjectId']").val(res.projectId);
							container.find("select[name='IdaTaskId']").val(res.taskId);
						}
						else if (res.activityTypeId == 2) {
							container.find("select[name='IdaTaskId']").val(res.taskId);
						}
						else if (res.activityTypeId == 3) {
							container.find("select[name='RegularActivityId']")
								.val(res.regularActivityId)
								.trigger("change");
						}

						// ========================
						// Ostala polja
						// ========================
						container.find("textarea[name='Activity']").val(res.activityName);

						// Ako bude trebalo:
						// container.find("input[name='TimeFromFormatted']").val(res.timeFrom);
						// container.find("input[name='TimeToFormatted']").val(res.timeTo);
					}
				});
			});

			$(document).on("change", "select[name='ActivityTypeId']", function() {
				let activityTypeId = $(this).val();
				let container;

				if ($(this).closest("tr").length) {
