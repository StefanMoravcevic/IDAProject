			$(document).on("change", "#planDate, input[name='SelectedShiftId']", function () {

				const selectedDate = $("#planDate").val();
				const selectedShiftId = $("input[name='SelectedShiftId']:checked").val();
				debugger
				if (!selectedDate || !selectedShiftId)
					return;

				const parts = selectedDate.split(".");
				if (parts.length !== 3) return;

				const dateObj = new Date(parts[2], parts[1] - 1, parts[0]);

				// današnji datum (bez vremena)
				const today = new Date();
				today.setHours(0, 0, 0, 0);
				dateObj.setHours(0, 0, 0, 0);

				// samo ako je datum u budućnosti
				if (dateObj <= today)
					return;

				$.ajax({
					url: "@Url.RouteUrl(RouteNames.TasksPlannings_CreateByShift)",
					method: "POST",
					data: {
						date: selectedDate,
						shiftId: selectedShiftId
					},
					success: function (response) {
					}
				});
			});
		});
