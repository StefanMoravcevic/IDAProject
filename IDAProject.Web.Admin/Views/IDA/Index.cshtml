		function updateColumnsByActivityType(activityTypeId, row) {
			// Sakrij sve kolone (td i th)
			$(".col-project, .col-task, .col-regular").hide();

			// Prikazi odgovarajuce kolone i resetuj selecte
			if (activityTypeId == 1) { // Project
				row.find("select[name='ProjectId'], select[name='IdaTaskId']").val(""); // reset polja ako je potrebno
				$(".col-project, .col-task").css('display','table-cell');

				// Puni task dropdown sa projectTasks
				let taskSelect = row.find("select[name='IdaTaskId']");
				let options = `<option value="">@localizer["Select task"]</option>` +
					projectTasks.map(x => `<option value="${x.Value}">${x.Description}</option>`).join('');
				taskSelect.html(options);

			} else if (activityTypeId == 2) { // Task
				row.find("select[name='IdaTaskId']").val("");
				$(".col-task").css('display','table-cell');

				// Puni task dropdown sa normal tasks
				let taskSelect = row.find("select[name='IdaTaskId']");
				let options = `<option value="">@localizer["Select task"]</option>` +
					tasks.map(x => `<option value="${x.Value}">${x.Description}</option>`).join('');
				taskSelect.html(options);

			} else if (activityTypeId == 3) { // Regular activity
				row.find("select[name='RegularActivityId']").val("");
				$(".col-regular").css('display','table-cell');
			}
		}

			function initTimePickers(container) {

				$(container).find('.timepicker').each(function () {

					if (!this._airDatepicker) {
						new AirDatepicker(this, {
							timepicker: true,
							onlyTimepicker: true,
							timeFormat: 'HH:mm',
							autoClose: true,
							buttons: false,
							minutesStep: 5,
							onSelect: function () {
							$(this.$el).trigger("change");
						},

						// 🔥 kad se zatvori picker (fallback)
						onClose: function () {
							$(this.$el).trigger("change");
