@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization 
@using IDAProject.Web.Admin.Models.Common
@inject IStringLocalizer<SharedResources> localizer

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - IDAProject</title>

    <link rel="shortcut icon" type="image/x-icon" href="~/images/favicon.ico" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/icons.css" />

    @RenderSection("Styles", required: false)
</head>

<body class="public-layout">

    <!-- HEADER (minimalan, bez user-a) -->
    <header class="border-bottom bg-white">
        <div class="container d-flex justify-content-between align-items-center py-2">

            <a href="/">
                <img src="~/images/Al Pack Group 181x52.png" style="max-height:50px;" />
            </a>

            <nav>
                <a class="me-3" href="@Url.RouteUrl(RouteNames.Home_Privacy)">
                    @localizer["Privacy"]
                </a>

                <a class="me-3" href="@Url.RouteUrl(RouteNames.Home_Terms)">
                    @localizer["Terms"]
                </a>
            </nav>

        </div>
    </header>

    <!-- CONTENT -->
    <main class="container mt-4">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="border-top mt-5 py-3">
        <div class="container text-center">
            <small>
                2026 - PrograM doo - All rights reserved
            </small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>