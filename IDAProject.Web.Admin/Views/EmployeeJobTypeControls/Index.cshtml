@model IDAProject.Web.Admin.Models.ViewModels.EmployeeJobTypeControls.EmployeeJobTypeControlsViewModel
@using IDAProject.Web.Admin.Models.Common;
@using IDAProject.Web.Models.General.Enums
@using IDAProject.Web.Models.RequestModels.MasterData;
@using IDAProject.Web.Admin.Models.TagHelpers;
@using System.ComponentModel;
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> localizer
@addTagHelper IDAProject.Web.Admin.TagHelpers.*, IDAProject.Web.Admin

@{

    ViewData["Title"] = $"Employee job types control";
    var localizedPagination = @Html.Raw(Json.Serialize(new PaginationLocalizerModel(localizer)));
    var urlDelete = Url.RouteUrl(RouteNames.EmployeeJobTypeControls_Delete, new { id = 111 });
}

<div class="row">
    <div class="col-md-12">
        <partial name="ContextOptionsPartial" model="@Model" />
    </div>
</div>
<div class="row row-sm">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body" style="overflow-x:auto">
                <tms-ajax-table id="tableEmployeeJobTypeControls" view-model="@Model" table-settings-reference-table="EmployeeJobTypeControls" />
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" type="text/css" href="~/lib/select2/select2.min.css" />
}
@section Scripts {

    <script type="text/javascript" src="~/lib/select2/select2.min.js"></script>
    <script type="text/javascript">

        function searchEmployeeJobTypeControls() {

            $.ajax({
                url: "@Url.RouteUrl(RouteNames.EmployeeJobTypeControls_Search)",
                method: "POST",
                data: {
                    employeeId : $("#EmployeeId").val(),
                    jobTypeId  : $("#JobTypeId").val()
                },
                success: function (response) {
                    loadJson("tableEmployeeJobTypeControls", response, @localizedPagination);
                }
            });
        }

        $(document).ready(function () {
            $("#edit").click(function () {
                var selectedId = getSelectedItemId("tableEmployeeJobTypeControls");
                document.location = '@Url.RouteUrl(RouteNames.EmployeeJobTypeControls_Edit, new { id = "111" })'.replace("111", selectedId);
            });
            $("#view").click(function () {
                var selectedId = getSelectedItemId("tableEmployeeJobTypeControls");
                document.location = '@Url.RouteUrl(RouteNames.EmployeeJobTypeControls_View, new { id = "111" })'.replace("111", selectedId);
            });
            $("#delete").click(function () {
                Swal.fire({
                    title: '@localizer["DeleteQuestion"]',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: '@localizer["DeleteConfirmation"]'
                }).then((result) => {
                    if (result.isConfirmed) {
                        var selectedId = getSelectedItemId("tableEmployeeJobTypeControls");
                        $.ajax({
                            url: '@urlDelete'.replace("111", selectedId),
                            method: "POST",
                            success: function (response) {
                                location = response.message;
                            }
                        });
                    }
                })
            });

            $("#EmployeeId").select2({});
            $("#JobTypeId").select2({});

            $("#buttonSearch").click(function(){
                searchEmployeeJobTypeControls();
            });
            $("#buttonResetSearch").click(function(){
                $("#EmployeeId").val(null).trigger("change");
                $("#JobTypeId").val(null).trigger("change");
                searchEmployeeJobTypeControls();
            });
            searchEmployeeJobTypeControls();
        });
    </script>
}